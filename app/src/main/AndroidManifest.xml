<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No storage permission is declared. The app's own OBB directory is reachable
      permission-free via context.obbDir, document import/export goes through the
      Storage Access Framework, and the bookmarks rescue export uses MediaStore.
      READ_EXTERNAL_STORAGE was removed as dead state: it was never requested at
      runtime, so it was never granted on any supported API level, and it is not
      grantable at all on API 33+.
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassicsViewer"
        tools:targetApi="31">
        
        <activity
            android:name=".AgeVerificationActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />
        
        <activity android:name=".AuthorListActivity" />
        <activity android:name=".WorkListActivity" />
        <activity android:name=".BookListActivity" />
        <activity android:name=".TextViewerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".TextViewerPagerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".DictionaryActivity" />
        <activity android:name=".LemmaOccurrencesActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".LicenseActivity" />
        <activity android:name=".DatabaseExtractionActivity" />
        <activity android:name=".DatabaseErrorActivity" />
        <activity android:name=".ui.BookmarksActivity" />
        <activity android:name=".ui.BookmarkEditorActivity" />
        <activity android:name=".audio.AudioManagementActivity" />
        <activity android:name=".ui.UserDictionaryImportActivity" />
        <activity android:name=".ManageLanguagesActivity" />
        <activity android:name=".FullDatabaseDownloadActivity" />
        <activity android:name=".AudioDownloadActivity" />
        <activity android:name=".alphabet.AlphabetGameActivity" />
        <activity android:name=".SentenceTreeActivity" />

        <activity android:name=".rhetoric.RhetoricActivity" />
        <activity android:name=".rhetoric.RhetoricEntryListActivity" />
        <activity android:name=".rhetoric.RhetoricEntryActivity" />

        <activity android:name=".topical.TopicalLinksActivity" />
        <activity android:name=".topical.TopicalDownloadActivity" />

        <activity android:name=".references.ReferencesListActivity" />
        <activity android:name=".references.ReferencesDownloadActivity" />
        <activity android:name=".references.PdfViewerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service android:name=".audio.AudioPlaybackService"
            android:exported="false" />
        
    </application>

</manifest>