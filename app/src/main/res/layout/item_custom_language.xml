<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customLanguageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/dragHandle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Drag to reorder"
            android:alpha="0.5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/customLanguageName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Language Name"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/customLanguageId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: language_id"
                android:textSize="14sp" />

        </LinearLayout>

        <Button
            android:id="@+id/editLanguageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/deleteLanguageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>