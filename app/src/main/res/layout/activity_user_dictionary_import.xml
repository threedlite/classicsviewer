<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="80dp"
    android:paddingBottom="16dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No custom dictionary selected"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/dictionaryInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:visibility="gone"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/selectDictionaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Dictionary ZIP"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.Button" />

    <Button
        android:id="@+id/switchDictionaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Switch Dictionary"
        android:textAllCaps="false"
        android:visibility="gone"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

    <Button
        android:id="@+id/removeDictionaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Remove Dictionary"
        android:textAllCaps="false"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Import a custom dictionary from a ZIP file containing:\n• dictionary.csv - Dictionary entries\n• morphology.csv - Word form mappings"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:lineSpacingExtra="4dp" />

</LinearLayout>

</ScrollView>

</FrameLayout>