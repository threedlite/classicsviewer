<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="64dp"
    android:paddingBottom="8dp"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    tools:context=".alphabet.AlphabetGameActivity">

    <!-- Header with controls and score -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/rounded_background"
        android:layout_marginBottom="4dp">

        <!-- Top row: dropdowns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Language selection -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/languageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Language:"
                    android:textSize="12sp"
                    android:textColor="#888888" />

                <Spinner
                    android:id="@+id/languageSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp" />
            </LinearLayout>

            <!-- Letter count selection -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/countLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Letters:"
                    android:textSize="12sp"
                    android:textColor="#888888" />

                <Spinner
                    android:id="@+id/countSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Combined forms checkbox -->
        <CheckBox
            android:id="@+id/combinedFormsCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Include combined forms"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:checked="false" />

    </LinearLayout>

    <!-- Points display -->
    <TextView
        android:id="@+id/pointsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Points: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="6dp"
        android:layout_marginBottom="4dp" />

    <!-- Game area with two columns -->
    <LinearLayout
        android:id="@+id/gameArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="@drawable/rounded_background">

        <!-- Letters column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/lettersTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Letters"
                android:textSize="12sp"
                android:textColor="#666666"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/lettersContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center" />
        </LinearLayout>

        <!-- Phonetics column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/phoneticsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phonetics"
                android:textSize="12sp"
                android:textColor="#666666"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/phoneticsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

    <!-- Message display -->
    <TextView
        android:id="@+id/messageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#4CAF50"
        android:minHeight="24dp"
        android:layout_marginTop="4dp" />

</LinearLayout>
