  "ἐρίζω": {
    "inflected_forms": [
      "ἐρίσωσι",
      "ἐρίσσεται",
      "ἐρίσσειε",
      "ἐρίσσειαν",
      "ἐρίσαντε",
      "ἐρίσαντες",
      "ἴσης",
      "βασιλεῦσιν",
      "μύθων",
      "ἔριζεν",
      "βασιλῆϊ",
      "παισίν",
      "ποσίν"
    ],
    "definition": "ἐρίζω [ἔρις]. 3 pl. pa. iterative ἐρίζεσκον θ225. 3 pl.\n   aor. subj. ἐρίσωσι σ277. 3 sing. opt. ἐρίσειε ψ126.\n   ἐρίσσειε Γ223: ο321, τ286. 3 pl. ἐρίσσειαν Ο284.\n   Nom. dual masc. pple. ἐρίσαντε Α6. Pl. ἐρίσαντες\n   Ν109. 3 sing. aor. subj. mid. ἐρίσσεται δ80.\n1. To be at variance, quarrel, wrangle, dispute:\n   διαστήτην ἐρίσαντε (having conceived offence) Α6,\n   περὶ ἴσης Μ423. --With dat.: βασιλεῦσιν Β214, 247,\n   κείνῳ ἐρίσαντες Ν109.\n2. To challenge. With dat. and infin.: ἀλλήλοιϊν\n   μαχέσσασθαι σ38.\n3. To engage in rivalry or competition: περὶ μύθων\n   Ο284.--To rival, compete with, vie with, a person:\n   Νέστωρ οἶος ἔριζεν Β555. Cf. τ286.--With dat.:\n   βασιλῆϊ Α277. Cf. Γ223, Ζ131, Ψ404: δ78, θ223, 225,\n   371, σ277, ψ126.--To match oneself with, stand up to\n   in fight. With dat.: Κρονίωνος παισίν Φ185.--With\n   dat. of that in which one vies with a person: ποσίν\n   Ν325.--With double dat.: δρηστοσύνῃ οὐκ ἄν μοι\n   ἐρίσσειεν ἄλλος ο321.--So in mid. Ε172: δ80.--With\n   dat. and acc.: εἰ Ἀφροδίτῃ κάλλος ἐρίζοι (in ...)\n   Ι389. Cf. ε213.",
    "headword_normalized": "εριζω"
  },
  "ἐρίηρος": {
    "inflected_forms": [],
    "definition": "ἐρίηρος [ἐρι- + (Ϝ)ήρ. Cf. ἐπιήρανος]. Pl. ἐρίηρες.\n   Epithet of ἑταῖρος, ἑταῖροι (and in α346, θ62, 471\n   of ἀοιδός), worthy, faithful, trusty or the like\n   Γ47, 378, Δ266, Θ332 = Ν421, Π363, Ψ6: α346, θ62 =\n   471, ι100, 172, 193, 555, κ387, 405, 408, 471, μ199,\n   397 (here merely conventional) = ξ249, ξ259 = ρ428,\n   τ273.",
    "headword_normalized": "εριηροσ"
  },
  "ἐριθηλής": {
    "inflected_forms": [
      "ἐριθηλέων",
      "ὄζους",
      "ἐλαίης"
    ],
    "definition": "ἐριθηλής, ές [ἐρι- + θηλ-, θάλλω]. Showing good growth,\n   flourishing: ἀλωάων ἐριθηλέων Ε90, μυρίκης ὄζους\n   Κ467, ἔρνος ἐλαίης Ρ53.",
    "headword_normalized": "εριθηλησ"
  },
  "ἔρῑθος": {
