  "καταδέω": {
    "inflected_forms": [],
    "definition": "καταδέω [κατα- (5)].\n1. To tie up or secure: [ἀσκὸν] μέρμιθι κ23.\n2. To tie or secure (a rope)  Ω274.\n3. To bind or secure (a person), put (him) in bonds\n   ξ345, ο443.--Sim.: τῶν ἄλλων ἀνέμων κελεύθους ε383.\n   Cf. κ20.--Fig.: κατέδησέ [με] κελεύθου (hindered me\n   from ...) η272.\n4. To halter or secure (a horse) Θ434, Κ567: δ40.--In\n   reference to a mule Ψ654.--To sheep κ572.--To goats\n   υ176.--To a cow and goats υ189.",
    "headword_normalized": "καταδεω"
  },
  "καταδημοβορέω": {
    "inflected_forms": [
      "καταδημοβορῆσαι"
    ],
    "definition": "καταδημοβορέω [κατα- (5) + δημοβορ-, δημοβόρος]. To\n   consume as part of the common stock: λαοῖσι δότω\n   καταδημοβορῆσαι Σ301.",
    "headword_normalized": "καταδημοβορεω"
  },
  "καταδράθω": {
