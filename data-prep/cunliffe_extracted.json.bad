  "κατωρυχής": {
    "inflected_forms": [],
    "definition": "κατωρυχής [κατ-, κατα- (1) + ὀρυχ-, ὀρύσσω]. Embedded,\n   partly sunk, in the ground: λάεσσιν ζ267, λίθοισιν\n   ι185.",
    "headword_normalized": "κατωρυχησ"
  },
  "καυλός": {
    "inflected_forms": [
      "ἐρραίσθη"
    ],
    "definition": "καυλός, οῦ, ὁ.\n1. In a spear, either\n        a. A tongue of metal continuing the head and\n       let into the wooden shaft (cf. πόρκης), or\n        b. The end of the shaft let into a hollow in\n       the head (αὐλός; see αὐλός (3)): ἐν καυλῷ ἐάγη\n       δόρυ (at the ...) Ν162, Ρ607. Cf. Ν608, Π115.\n2. In a sword, a tongue of metal continuing the blade\n   and secured between the wooden pieces forming the\n   handle: ἀμφὶ καυλὸν φάσγανον ἐρραίσθη Π338.",
    "headword_normalized": "καυλοσ"
  },
  "καῦμα": {
    "inflected_forms": [],
    "definition": "καῦμα, ατος, τό [καϜ-, καυ-, καίω]. Heat, hot weather:\n   καύματος ἔξ (after ...) Ε865.",
    "headword_normalized": "καυμα"
  },
  "καύστειρα": {
    "inflected_forms": [
