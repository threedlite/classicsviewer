  "σός": {
    "inflected_forms": [
      "γέρας"
    ],
    "definition": "σός, σή, σόν [σοῦ, a genit. of σύ]. Genit. pl. fem.\n   σέων (scanned as one syllable) Ε818. Thy, your (cf.\n   τεός) Α42, 179, 297, Γ50, 174, Δ60, 262, etc.: α195,\n   402, β112, 178, γ117, etc.--With the article: τὸ σὸν\n   γέρας Α185. Cf. Π40, etc.: β403, ξ512, etc.--Absol.:\n   ἐπὶ σοῖσι καθήμενος (where your heritage is) β369.\n   Cf. Ψ83.--With the article Ψ572.--As predicative\n   adj., thine: εἰ σός εἰμι ι529.",
    "headword_normalized": "σοσ"
  },
  "σοφίη": {
