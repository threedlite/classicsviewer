  "ὀχός": {
    "inflected_forms": [],
    "definition": "ὀχός, οῦ, ὄχος, -ου, ὁ [ὀχ-, ἔχω]. Something that\n   affords safety or security: λιμένες νηῶν ὀχοί ε404.",
    "headword_normalized": "οχοσ"
  },
  "ὄψ": {
    "inflected_forms": [
      "καλῇ",
      "ὄπα"
    ],
    "definition": "ὄψ, ὀπός, ἡ (Ϝόψ). A voice: ἄειδον ἀμειβόμεναι ὀπὶ καλῇ\n   Α604. Cf. Γ221, Ξ150, Π76, Σ222, Χ451: ἤκουσα ὄπα\n   Πριάμοιο θυγατρός λ421. Cf. ε61, κ221, μ52, 160,\n   185, 187, 192, ξ492, υ92, ω60.--Of lambs Δ435.--Of\n   the cicada Γ152.--With special reference to what is\n   uttered: ξυνέηκε θεᾶς ὄπα Β182 = Κ512. Cf. Η53,\n   Λ137, Υ380, Φ98: ω535.",
    "headword_normalized": "οψ"
  },
  "ὀψέ": {
    "inflected_forms": [
      "τελεῖ",
      "ἐρύεσθαι"
    ],
    "definition": "ὀψέ.\n1. Not early, late: ὀψὲ δύοντα Βοώτην ε272. Cf. Φ232.\n2. Long after, after a long interval: ὀψὲ μετὰ νῶϊ κίεν\n   γ168.\n3. After the lapse of a long time, late: ὀψέ περ ἐλθών\n   ψ7. Cf. ι534, λ114 = μ141.--At length, at last: ὀψὲ\n   τελεῖ Δ161. Cf. Η94, 399 = Ι31 = 696, Θ30, Ι432,\n   Ρ466: δ706, ε322, η155, μ439, υ321.\n4. At a late stage, late in the day: καὶ ὀψέ περ υἷας\n   Ἀχαιῶν ἐρύεσθαι Ι247.",
    "headword_normalized": "οψε"
  },
  "ὀψείω": {
    "inflected_forms": [
      "πολέμοιο"
    ],
    "definition": "ὀψείω [ὀπ-σείω. Desiderative fr. ὀπ-. See ὁράω]. To\n   desire to see, go to view. With genit.: ἀϋτῆς καὶ\n   πολέμοιο Ξ37.",
    "headword_normalized": "οψειω"
  },
  "ὀψίγονος": {
    "inflected_forms": [
      "ἄνθρωποι"
    ],
    "definition": "ὀψίγονος [ὀψέ + γον- = γεν-, γίγνομαι]. Of a generation\n   later than one's own, late-born: τί σευ ἄλλος\n   ὀνήσεται ὀ. περ; Π31.--Absol. in pl., the men of the\n   generations to come, posterity α302 = γ200.--So with\n   ἄνθρωποι Γ353, Η87.",
    "headword_normalized": "οψιγονοσ"
  },
  "ὄψιμος": {
    "inflected_forms": [
      "τέρας"
    ],
    "definition": "ὄψιμος [ὀψέ]. Having reference to a date in the far\n   future, pointing far forward: τέρας Β325.",
    "headword_normalized": "οψιμοσ"
  },
  "ὄψις": {
    "inflected_forms": [
      "ἀτυχθείς",
      "ἀγαθήν"
    ],
    "definition": "ὄψις, ἡ [ὀπ-. See ὁράω].\n1. Exercise of the power of vision: ὄψει οὔ πω σὺ ἐμοὺς\n   ἴδες (with your eyes) Υ205. Cf. ψ94.\n2. The fact of seeing something, the sight of ...:\n   πατρὸς ὄψιν ἀτυχθείς Ζ468.\n3. Appearance, outward seeming: ἀγαθήν Ω632.",
    "headword_normalized": "οψισ"
  },
  "ὀψιτέλεστος": {
    "inflected_forms": [
