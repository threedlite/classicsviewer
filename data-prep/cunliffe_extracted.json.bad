  "ἀκριτόμῡθος": {
    "inflected_forms": [],
    "definition": "ἀκριτόμῡθος [ἄκριτος + μῦθος].\n1. Indiscriminate or reckless in speech Β246.\n2. Hard to be discerned or interpreted ὄνειροι τ560.",
    "headword_normalized": "ακριτομυθοσ"
