  "καρπάλιμος": {
    "inflected_forms": [],
    "definition": "καρπάλιμος [καρπ- = κραπ- as in κραιπνός]. Swift.\n   Epithet of the feet Π342, 809, Χ166.",
    "headword_normalized": "καρπαλιμοσ"
