  "πόρον": {
    "inflected_forms": [],
    "definition": "πόρον, aor. πόρω.",
    "headword_normalized": "πορον"
  },
  "πόρος": {
    "inflected_forms": [],
    "definition": "πόρος, ου, ὁ [πορ-, περάω]. A place where a river may\n   be passed, a ford Β592, Ξ433 = Φ1 = Ω692.--πόροι\n   ἁλός, the paths of the sea μ259.",
    "headword_normalized": "ποροσ"
  },
  "πόρπη": {
    "inflected_forms": [
      "περόνη"
    ],
    "definition": "πόρπη, ης, ἡ [πορ-, πείρω]. App. = περόνη Σ401.",
    "headword_normalized": "πορπη"
  },
  "πορσαίνω": {
    "inflected_forms": [
      "πορσανέουσα",
      "λέχος"
    ],
    "definition": "πορσαίνω [πόρω]. Nom. sing. fem. fut. pple. πορσανέουσα\n   Γ411. Also πορσύ̄νω. Of a wife, to prepare (and\n   share) (her husband's bed): κείνου πορσανέουσα λέχος\n   Γ411: τῷ ἄλοχος λέχος πόρσυνεν γ403. Cf. η347.",
    "headword_normalized": "πορσαινω"
  },
  "πόρταξ": {
    "inflected_forms": [],
    "definition": "πόρταξ, ακος. = next Ρ4.",
    "headword_normalized": "πορταξ"
  },
  "πόρτις": {
    "inflected_forms": [],
    "definition": "πόρτις, ἡ [cf. πόρις]. A calf Ε162.",
    "headword_normalized": "πορτισ"
  },
  "πορφύρεος": {
    "inflected_forms": [
      "ποταμοῖο",
      "αὐτήν",
      "θάνατος",
      "ἶριν",
      "πορφυρέῳ",
      "δίπλακα",
      "φᾶρος",
      "τάπησιν",
      "ῥήγεα"
    ],
    "definition": "πορφύρεος, η, -ον [cf. next].\n1. Of disturbed water, gleaming, glancing: πορφύρεον\n   κῦμα ποταμοῖο Φ326, ἀμφὶ κῦμα στείρῃ πορφύρεον\n   μεγάλ’ ἴαχεν (flashing as it fell off on each side\n   of the cutwater) Α482: = β428. Cf. Π391: λ243, ν85\n   (the white wake).--So in reference to the light\n   reflected from (the irregular surface of) a cloud:\n   πορφυρέῃ νεφέλῃ πυκάσασα ἓ αὐτήν Ρ551. --Applied to\n   the sinister gleam figured to play on (the cloud or\n   mist of) death: πορφύρεος θάνατος Ε83 = Π334 = Υ477.\n   --To the lurid gleam of the rainbow set against a\n   storm-cloud: πορφυρέην ἶριν Ρ547.--To the warm hue\n   of blood: αἵματι πορφυρέῳ Ρ361.\n2. Of bright hue, bright, brilliant, gay: δίπλακα Γ126,\n   Χ441, φᾶρος Θ221, τάπησιν Ι200, ῥήγεα Ω645,\n   πέπλοισιν796: χλαῖναν δ115 = 154, τ225, ῥήγεα δ298 =\n   η337, κ353, φᾶρος θ84, σφαῖραν 373, δίπλακα τ242,\n   τάπητας υ151.",
    "headword_normalized": "πορφυρεοσ"
  },
  "πορφύ̄ρω": {
    "inflected_forms": [
      "πόρφυρεν"
    ],
    "definition": "πορφύ̄ρω [redup. fr. φύρω]. Of the disturbed sea, to\n   heave Ξ16.--Fig., of the heart, to be troubled,\n   moved, stirred: πολλά οἱ κραδίη πόρφυρεν Φ551. Cf.\n   δ427 = 572 = κ309.",
    "headword_normalized": "πορφυρω"
  },
  "πόρω": {
