  "προκαλέω": {
    "inflected_forms": [
      "προκαλέσσατο",
      "προκαλέσσεται",
      "προκάλεσσαι",
      "ἐναντίον"
    ],
    "definition": "†προκαλέω [προ- (1)]. 3 sing. aor. mid. προκαλέσσατο\n   Η218, 285, Ν809. 3 sing. subj. προκαλέσσεται Η39.\n   Imp. προκάλεσσαι Γ432, Η50: θ142. In mid., to summon\n   or invite to the fight or to a contest, challenge,\n   defy, dare: μαχέσασθαι ἐναντίον Γ432. Cf. Η39, 50,\n   218, 285, Ν809: θ142.",
    "headword_normalized": "προκαλεω"
