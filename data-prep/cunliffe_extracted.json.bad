      "νῆας",
      "ἐκάκωσεν",
      "ψυχή",
      "ἄμυδις",
      "μάχη",
      "ἦλθεν",
      "ἄντα",
      "ἀγχίμολον",
      "ἐναντίβιον",
      "κατεναντίον",
      "πολέμοιο",
      "κέλευθα",
      "αὖτις",
      "ἔλθοι",
