  "ἧμαι": {
    "inflected_forms": [
      "ἥμενος",
      "ἧσθαι",
      "ἧμαι",
      "ἧσαι",
      "ἧσται",
      "ἥμεθα",
      "εἵαται",
      "ἕαται",
      "ἥμην",
      "ἧστο",
      "ἥσθην",
      "εἵατο",
      "ἕατο",
