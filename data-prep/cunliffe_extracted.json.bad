    "headword_normalized": "ρυσαμην"
  },
  "ῥῦσθαι": {
    "inflected_forms": [],
    "definition": "ῥῦσθαι, non-thematic pres. infin. mid. ἐρύω.",
    "headword_normalized": "ρυσθαι"
