  "σποδός": {
    "inflected_forms": [],
    "definition": "σποδός, οῦ, ἡ. Smouldering ashes, embers: μοχλὸν ὑπὸ\n   σποδοῦ ἤλασα πολλῆς ι375.",
    "headword_normalized": "σποδοσ"
