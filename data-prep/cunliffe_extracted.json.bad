  "ἀνήνοθε": {
    "inflected_forms": [],
    "definition": "†ἀνήνοθε [3 sing., in the first passage of a plupf.\n   (with secondary person-ending), in the second of a\n   pf., fr. ἀνεθ- + ἀνθ-, ἄνθος. (Cf. ἐνήνοθε)]. (ἐπ-.)\n   To come to the surface, come forth: αἷμ’ ἀ. Λ266.--\n   To rise up, spread upwards: κνίση ἀ. ρ270.",
    "headword_normalized": "ανηνοθε"
  },
  "ἀνήνυστος": {
