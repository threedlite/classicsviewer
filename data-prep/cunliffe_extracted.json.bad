  "προσαυδάω": {
    "inflected_forms": [
      "προσαυδήτην",
      "προσηύδα",
      "πτερόεντα"
    ],
    "definition": "προσαυδάω [προσ- (3)]. 3 dual non-thematic impf.\n   προσαυδήτην Λ136, Χ90.\n1. To speak to, address, accost: κερτομίοισι Διὰ\n   προσηύδα Α539. Cf. Δ192, 256, Ε30, Ζ144, Λ136, etc.:\n   α252, γ41, ι345, λ99, ξ484, etc.--Without expressed\n   object, to make address, speak Δ24, Η225, Μ353,\n   etc.: κ400, ξ79, ο62, etc.\n2. To say in way of address, speak, utter: ἔπεα\n   πτερόεντα Δ92, 203, Ε871, Π706, etc.: β362, δ25,\n   κ377, π22, etc.\n3. With double construction of (1) and (2), to address\n   words to: ἔπεά μιν πτερόεντα προσηύδα Α201. Cf. Δ69,\n   Ε242, Μ365, Ν94, etc.: α122, δ77, κ265, π7, etc.",
    "headword_normalized": "προσαυδαω"
  },
  "προσβαίνω": {
    "inflected_forms": [
      "προσεβήσετο",
      "προσβάς",
      "προσέβαν",
      "Ἴδης",
      "Ὄλυμπον"
    ],
    "definition": "†προσβαίνω [προσ- (1) (2)]. 3 sing. aor. προσέβη ξ1. 3\n   pl. προσέβαν Ψ117: τ431. Pple. προσβάς Ε620, Π863. 3\n   sing. aor. mid. προσεβήσετο Β48, Ξ292: φ5, 43.\n1. To go one's way, proceed, in a specified direction:\n   προσέβη τρηχεῖαν ἀταρπόν (advbl. acc., 'by a ...')\n   ξ1.\n2. To go to or towards, approach. With acc.: κνημοὺς\n   Ἴδης Ψ117. Cf. τ431.--In mid.: Ὄλυμπον Β48. Cf.\n   Ξ292.\n3. To step upon, set foot upon. With acc. In mid.:\n   κλίμακα φ5, οὐδόν43.--Without expressed object: λὰξ\n   προσβάς (setting his foot upon the corpse) Ε620,\n   Π863.",
    "headword_normalized": "προσβαινω"
  },
  "προσβάλλω": {
    "inflected_forms": [
      "ἀρούρας",
      "προτιβάλλεαι"
    ],
    "definition": "προσβάλλω, προτιβάλλω [προσ- (3)].\n1. To smite. Of the rays of the sun: Ἠέλιος νέον\n   προσέβαλλεν ἀρούρας Η421: = τ433.\n2. In mid., to give heed to, direct one's attention to:\n   ταύτην οὐ προτιβάλλεαι Ε879.",
    "headword_normalized": "προσβαλλω"
  },
  "προσδέρκομαι": {
