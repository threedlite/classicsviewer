  "θαλπωρή": {
    "inflected_forms": [
      "ἔσται"
    ],
    "definition": "θαλπωρή, ἡ [θάλπω]. Warmth; hence\n1. Comfort, consolation, cheering: οὐκ ἄλλη ἔσται θ.\n   Ζ412. Cf. α167.\n2. Heartening, confidence: μᾶλλον θ. ἔσται Κ223.",
    "headword_normalized": "θαλπωρη"
  },
  "θάλυς": {
    "inflected_forms": [
      "κῆρ"
    ],
    "definition": "θάλυς, εια, -υ [θάλλω].\n1. Of a feast, sumptuous, affording good cheer Η475:\n   γ420, θ76, 99.\n2. Absol. in neut. pl., good cheer: θαλέων ἐμπλησάμενος\n   κῆρ Χ504.",
    "headword_normalized": "θαλυσ"
