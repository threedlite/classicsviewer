    "headword_normalized": "κυανωπισ"
  },
  "κυβερνάω": {
    "inflected_forms": [],
    "definition": "κυβερνάω. To steer (a ship), keep (her) on her course:\n   νῆα κυβερνῆσαι γ283.",
    "headword_normalized": "κυβερναω"
  },
  "κυβερνητήρ": {
    "inflected_forms": [],
    "definition": "κυβερνητήρ, ῆρος, ὁ [as next]. = next: οὐ Φαιήκεσσι\n   κυβερνητῆρες ἔασιν θ557.",
    "headword_normalized": "κυβερνητηρ"
