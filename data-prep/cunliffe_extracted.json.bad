  "λωτός": {
    "inflected_forms": [
      "ἐρεπτόμενοι"
    ],
    "definition": "λωτός, οῦ, ὁ.\n1. A plant, perh. some kind of trefoil or clover.\n   Collectively: ἵπποι λωτὸν ἐρεπτόμενοι Β776. Cf.\n   Ξ348, Φ351: δ603.\n2. A fruit of some kind, described as having an\n   irresistibly seductive taste ι93, 97, 102.--The tree\n   producing the fruit ι94.",
    "headword_normalized": "λωτοσ"
  },
  "Λωτοφάγοι": {
    "inflected_forms": [],
    "definition": "Λωτοφάγοι, οἱ [λωτός (2) + φάγον]. The lotus-eaters\n   ι84, 91, 92, 96, ψ311.",
