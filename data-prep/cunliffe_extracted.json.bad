  "θῡμαλγής": {
    "inflected_forms": [],
    "definition": "θῡμαλγής [θυμός + ἄλγος]. Paining or burdening the\n   heart, painful, distressing, grievous Δ513, Ι260,\n   387, 565: θ272, π69, σ347 = υ285, υ118, χ189, ψ64,\n   183, ω326.",
    "headword_normalized": "θυμαλγησ"
  },
  "θῡμᾱρής": {
    "inflected_forms": [
      "ἄλοχον"
    ],
    "definition": "θῡμᾱρής, ές [θυμός + ἀρ-, ἀραρίσκω. 'Fitted to the\n   heart']. Neut. in form θῡμῆρες κ362.\n1. Such as to inspire affection, lovely, beauteous:\n   ἄλοχον Ι336: ψ232.\n2. Suited to one's taste, grateful to the senses:\n   [ὕδωρ] θυμῆρες κεράσασα (till it became ...) κ362.\n3. Suited to one's needs, serviceable: σκῆπτρον ρ199.",
    "headword_normalized": "θυμαρησ"
  },
  "θῡμηγερέων": {
    "inflected_forms": [],
    "definition": "θῡμηγερέων [θυμός + ἀγερ-, ἀγείρω]. Endeavouring to\n   rally one's spirit, making a fight for life: ἐκ δ’\n   ἔπεσον θυμηγερέων η283.",
    "headword_normalized": "θυμηγερεων"
  },
  "θῡμηδής": {
    "inflected_forms": [],
    "definition": "θῡμηδής, ές [θυμός + ἡδύς]. Pleasing to the heart,\n   desirable, choice: χρήματα π389.",
    "headword_normalized": "θυμηδησ"
  },
  "θῡμῆρες": {
    "inflected_forms": [],
    "definition": "θῡμῆρες. See θυμαρής.",
    "headword_normalized": "θυμηρεσ"
  },
  "θῡμοβόρος": {
    "inflected_forms": [
      "ἔρις"
    ],
    "definition": "θῡμοβόρος, ον [θυμός + βορ-, βι-βρώσκω]. Eating the\n   heart, that will not leave the heart in peace.\n   Epithet of ἔρις Η210, 301, Π476, Τ58, Υ253.",
    "headword_normalized": "θυμοβοροσ"
  },
  "θῡμοδακής": {
    "inflected_forms": [
      "μῦθος"
    ],
    "definition": "θῡμοδακής [θυμός + δακ-, δάκνω]. Biting the heart,\n   stinging to action: μῦθος θ185. (Cf. δάκε φρένας\n   μῦθος Ε493.)",
    "headword_normalized": "θυμοδακησ"
