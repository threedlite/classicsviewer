  "τάλας": {
    "inflected_forms": [],
    "definition": "τάλας [ταλα-, τλάω]. Voc. τάλαν in passages cited.\n   Wretched, miserable. In abuse: ξεῖνε τάλαν σ327.--\n   Absol.: ἔξελθε, τάλαν (wretch!) τ68.",
    "headword_normalized": "ταλασ"
  },
  "ταλασίφρων": {
    "inflected_forms": [],
    "definition": "ταλασίφρων, ονος [ταλασι-, τλάω + φρήν]. Stout-hearted,\n   steadfast in mind. Epithet of Odysseus Λ466: α87 =\n   ε31, δ241, ρ34, σ311, etc.--Absol. Δ421.",
    "headword_normalized": "ταλασιφρων"
