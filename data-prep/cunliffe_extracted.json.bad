  "οἰνοχόος": {
    "inflected_forms": [],
    "definition": "οἰνοχόος, ου, ὁ [οἶνος + χέω]. One who pours out wine\n   for drinking, a cup-bearer: οἰνοχόος ἐπαρξάσθω\n   δεπάεσσιν σ418, φ263. Cf. Β128: ι10, σ396.",
    "headword_normalized": "οινοχοοσ"
  },
  "οἶνοψ": {
    "inflected_forms": [],
    "definition": "οἶνοψ, οπος [οἶνος + ὀπ-. See ὁράω]. Dark in hue like\n   wine.\n1. Epithet of πόντος, wine-dark, purple Β613, Ε771,\n   Η88, Ψ143, 316: α183, β421, γ286, δ474, ε132, etc.\n2. Epithet of oxen, app., of the characteristic dark\n   hue of most of the species, i.e. dark brown Ν703:\n   ν32.",
    "headword_normalized": "οινοψ"
  },
  "οἰνόω": {
    "inflected_forms": [],
    "definition": "οἰνόω [οἶνος]. To make drunk; in pass., to become\n   drunk: μή πως οἰνωθέντες ἀλλήλους τρώσητε (in an\n   access of drunkenness) π292 = τ11.",
    "headword_normalized": "οινοω"
