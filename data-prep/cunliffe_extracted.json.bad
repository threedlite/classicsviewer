  "μέχρι(ς)": {
    "inflected_forms": [
      "θαλάσσης"
    ],
    "definition": "μέχρι(ς). With genit.\n1. As far as, to: μέχρι θαλάσσης Ν143.\n2. Until: τέο μέχρις; (how long ?) Ω128.",
    "headword_normalized": "μεχρισ"
