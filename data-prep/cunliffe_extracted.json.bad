  "θεμείλια": {
    "inflected_forms": [],
    "definition": "θεμείλια, τά [as prec.]. Supports, consisting of stakes\n   or stones, set to contain the face of an earth work\n   or mound (cf. στήλη (1)) Μ28, Ψ255.",
