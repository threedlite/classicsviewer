  "φυλακή": {
    "inflected_forms": [
      "μνήσασθε",
      "ἔχον",
      "εὐναί"
    ],
    "definition": "φυλακή, ῆς, ἡ [φυλακ-, φύλαξ].\n1. Guarding, warding, watching: φυλακῆς μνήσασθε Η371 =\n   Σ299. Cf. Θ521, Κ99.--In sim. sense in pl.: φυλακὰς\n   ἔχον Ι1, 471.\n2. An outpost: Τρώων φυλακαί τε καὶ εὐναί Κ408. Cf.\n   Κ416.",
    "headword_normalized": "φυλακη"
  },
  "φυλάκους": {
