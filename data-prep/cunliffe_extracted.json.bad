  "ἀτάσθαλος": {
    "inflected_forms": [
      "μένος",
      "μηχανόωντο"
    ],
    "definition": "ἀτάσθαλος, ον.\n1. Reckless, careless of consequences, ungoverned Χ418:\n   η60, θ166, ω282.\n2. Of character, deeds, etc., displaying such\n   characteristics: μένος Ν634. Cf. π86, χ314, ω352.\n3. In neut. ἀτάσθαλον, a deed displaying such\n   characteristics: οὔ ποτ’ ἀ. ἄνδρα ἐώργει δ693.--In\n   neut. pl. ἀτάσθαλα, such deeds: ἀ. μηχανόωντο Λ695.\n   Cf. γ207, π93, ρ588, σ139, 143, υ170, 370, χ47.",
    "headword_normalized": "ατασθαλοσ"
  },
  "ἀτειρής": {
    "inflected_forms": [
      "χαλκός"
    ],
    "definition": "ἀτειρής [ἀ- + τείρω].\n1. Not to be worn away, hard: χαλκός Ε292. Cf. Η247,\n   Ξ25, Σ474, Τ233, Υ108: ν368.--Fig., of the heart\n   Γ60.\n2. Not liable to fatigue Ο697.--Of the voice (cf.\n   ἄρρηκτος (4)) Ν45, Ρ555, Χ227.--Sim. of character:\n   Μένος αἰὲν ἀ. (sturdy, unwearying) λ270.",
    "headword_normalized": "ατειρησ"
  },
  "ἀτέλεστος": {
    "inflected_forms": [
      "ἀτέλεστα",
      "πόνον"
    ],
    "definition": "ἀτέλεστος, ον [ἀ- + τελες-, τελέω].\n1. Not accomplished or performed: τὰ ἔσσεται οὐκ\n   ἀτέλεστα Δ168. Cf. β273, θ571, σ345.\n2. To no end, resulting in nothing: πόνον Δ26, 57.\n3. In neut. ἀτέλεστον as adv., endlessly, continually\n   π111.",
    "headword_normalized": "ατελεστοσ"
