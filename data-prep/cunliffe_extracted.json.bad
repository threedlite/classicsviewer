    "headword_normalized": "φυκοσ"
  },
  "φυκτός": {
    "inflected_forms": [
      "πέλωνται"
    ],
    "definition": "φυκτός [φεύγω]. That may be fled from. Absol. in neut.\n   pl. φυκτά, means or opportunity of fleeing or escape\n   (cf. πιστός (2) (b)): μὴ οὐκέτι φυκτὰ πέλωνται Π128.\n   Cf. θ299, ξ489.",
    "headword_normalized": "φυκτοσ"
