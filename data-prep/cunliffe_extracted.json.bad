  "συφορβός": {
    "inflected_forms": [
      "συφορβόν"
    ],
    "definition": "συφορβός, οῦ, ὁ [σῦς + φέρβω, to feed]. Also ὑφορβός. A\n   swineherd: ὡς παῖδα συφορβόν Φ282. Cf. ξ410, 504.--\n   Of Eumaeus. In form συφορβός π154, ρ348, φ189, etc.\n   --In form ὑφορβός ξ3, ο301, π20, etc.",
    "headword_normalized": "συφορβοσ"
