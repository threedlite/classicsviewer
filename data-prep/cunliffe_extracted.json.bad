  "μεταδήμιος": {
    "inflected_forms": [],
    "definition": "μεταδήμιος [μετα- (3) + δῆμος]. Among the (i.e. one's\n   own) people, at home: οὐ γὰρ ἔθ’ Ἥφαιστος μ. θ293.--\n   Among, afflicting, the people: κακὸν μεταδήμιον ν46.",
    "headword_normalized": "μεταδημιοσ"
  },
  "μεταδόρπιος": {
    "inflected_forms": [],
    "definition": "μεταδόρπιος [app. μετα- (3) + δόρπον (the apparatus of\n   the meal, rather than the meal, being thought of)].\n   Thus, in the middle of, at, δόρπον: οὐ γὰρ ἐγώ γε\n   τέρπομ’ ὀδυρόμενος μ. (in the midst of good cheer)\n   δ194.",
    "headword_normalized": "μεταδορπιοσ"
