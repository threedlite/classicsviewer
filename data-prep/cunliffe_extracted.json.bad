  "φύγαδε": {
    "inflected_forms": [
      "ἵππους"
    ],
    "definition": "φύγαδε [φυγή + -δε (1)]. To or in the direction of\n   flight, to flee: φύγαδε τράπεν ἵππους Θ157, 257. Cf.\n   Λ446, Π657, 697 (see μνάομαι (2)).",
    "headword_normalized": "φυγαδε"
