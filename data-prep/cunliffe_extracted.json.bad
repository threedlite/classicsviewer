  "πλήξιππος": {
    "inflected_forms": [],
    "definition": "πλήξιππος [πληξ-, πλήσσω + ἵππος]. Smiter of horses.\n   Epithet of Pelops Β104.--Of Menestheus Δ327.--Of\n   Orestes Ε705.--Of OÃ¯leus Λ93.",
    "headword_normalized": "πληξιπποσ"
