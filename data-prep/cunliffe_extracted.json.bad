  "ἡγήτωρ": {
    "inflected_forms": [
      "ἦσαν",
      "ἄνδρες"
    ],
    "definition": "ἡγήτωρ, ορος, ὁ [ἡγέομαι]. A leader, commander or\n   chief: δύω ἡγήτορες ἦσαν Δ393. Cf. Β79, Γ153, Κ181,\n   Ο330, Υ383, etc.: Ταφίων α105. Cf. η98, 136, 186 =\n   θ26 = 97 = 387 = 536, θ11, λ526, ν186, 210.--With\n   ἀνήρ: Πυλίων ἡγήτορες ἄνδρες Λ687. Cf. Π495, 532.",
    "headword_normalized": "ηγητωρ"
  },
  "ἠδέ": {
    "inflected_forms": [
      "αἰγῶν",
      "ἀνδρῶν"
    ],
    "definition": "ἠδέ [ἦ δέ]. And: ταύρων ἠδ’ αἰγῶν Α41. Cf. Α96, 251,\n   Β27, 79, 118, etc.: α13, 95, 135, 170, 182, 231,\n   etc.--So ἠδὲ καί: Διὸς ἄγγελοι ἠδὲ καὶ ἀνδρῶν Α334,\n   etc. Cf. β209, etc.--Correlative with ἠμέν. See\n   ἠμέν.",
    "headword_normalized": "ηδε"
  },
  "ἤδεα": {
