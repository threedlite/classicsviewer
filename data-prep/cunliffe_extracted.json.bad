  },
  "εὐερκής": {
    "inflected_forms": [
      "αὐλή"
    ],
    "definition": "εὐερκής [εὐ- (5) + ἕρκος]. Well fenced or walled.\n   Epithet of αὐλή Ι472: φ389, χ449.--Of doors  or\n   gates, securely barring passage, stout: θύραι ρ267.",
    "headword_normalized": "ευερκησ"
  },
  "ἐΰζυγος": {
