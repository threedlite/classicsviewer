  "ἕδρη": {
    "inflected_forms": [
      "ἕδρης",
      "ἕδρῃ"
    ],
    "definition": "ἕδρη, ης, ἡ [as ἕδος].\n1.\n        a. A seat: ἄλλοθι δήομεν ἕδρην π44. Cf. γ429,\n       θ16.\n        b. One's seat: αὐτόθεν ἐξ ἕδρης Τ77. Cf. Β99,\n       211: ν56, π42.\n2. A seat of honour: τίον σε ἕδρῃ Θ162. Cf. Μ311.\n3. A company sitting together: ἐννέα ἕδραι ἔσαν γ7, 31.",
    "headword_normalized": "εδρη"
  },
  "ἑδριάομαι": {
    "inflected_forms": [
      "ἑδριάασθαι",
      "ἑδριόωντο",
      "κατά"
    ],
    "definition": "†ἑδριάομαι [(σ)εδ-, ἕζομαι]. 3 pl. impf. ἑδριόωντο\n   Κ198: η98, π344. Infin. ἑδριάασθαι Λ646, 778: γ35.\n1. To sit down Κ198: γ35, π344.--With κατά Λ646 = 778.\n2. To sit, be seated: ἔνθ’ ἑδριόωντο πίνοντες η98.",
    "headword_normalized": "εδριαομαι"
  },
  "ἔδῡσαν": {
    "inflected_forms": [],
    "definition": "ἔδῡσαν, 3 pl. sigmatic aor. δύω.",
    "headword_normalized": "εδυσαν"
