  "προερέσσω": {
    "inflected_forms": [
      "προέρεσσαν"
    ],
    "definition": "†προερέσσω [προ- (1)]. 1 pl. aor. προερέσσαμεν ι73,\n   ν279. 3 προέρεσσαν Α435: ο497. To row one's ship\n   forward, row it to a specified place ν279.--To row\n   (one's ship) forward, row (it) to a specified place:\n   νῆ’ εἰς ὅρμον προέρεσσαν Α435: = ο497. Cf. ι73.",
    "headword_normalized": "προερεσσω"
  },
  "προερύω": {
    "inflected_forms": [
