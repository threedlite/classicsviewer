  "ἐπηγκενίδες": {
    "inflected_forms": [],
    "definition": "ἐπηγκενίδες, αἱ [app. ἐπ-, ἐπι- (1) + ἐνεγκέμεν. See\n   φέρω]. Dat. ἐπηγκενίδεσσι. The pieces fitted upon\n   the top of the ἴκρια of the σχεδίη of Odysseus, and\n   forming the upper surface thereof ε253.",
    "headword_normalized": "επηγκενιδεσ"
