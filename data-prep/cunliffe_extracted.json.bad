  "ληΐς": {
    "inflected_forms": [
      "ληΐδα"
    ],
    "definition": "ληΐς, ΐδος, ἡ. Spoil, booty: ὅτε κεν δατεώμεθα ληΐδα\n   Ι138 = 280. Cf. Λ677, Μ7, Σ327: μενοεικέα σφι ληΐδα\n   δῶκα (booty which he had in hand) ν273. Cf. γ106,\n   ε40 = ν138, κ41, ν262, ξ86.",
    "headword_normalized": "ληισ"
