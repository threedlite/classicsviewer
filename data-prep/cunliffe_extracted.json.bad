  "γλυκερός": {
    "inflected_forms": [
      "σίτου",
      "ὕπνος",
      "μολπῆς"
    ],
    "definition": "γλυκερός, ή, όν [cf. γλυκύς].\n1. Sweet or pleasant to the taste: σίτου Λ89: συκέαι\n   η116 = λ590 (the tree for the fruit). Cf. δ88, ξ194,\n   υ69, ω68.--Of water, sweet, fit for drinking μ306.\n2. Generally, sweet, pleasant, giving delight or joy:\n   ὕπνος Κ4, μολπῆς Ν637. Cf. Ω3, 636: δ295, ε472, π23\n   = ρ41, τ511, χ323, ψ145, 255.--In comp.: ἧς γαίης\n   γλυκερώτερον ἄλλο ι28.",
    "headword_normalized": "γλυκεροσ"
  },
  "γλυκύθῡμος": {
    "inflected_forms": [
      "ἀνήρ"
    ],
    "definition": "γλυκύθῡμος [γλυκύς + θυμός]. Of gentle or kindly mind:\n   ἀνήρ Υ467.",
    "headword_normalized": "γλυκυθυμοσ"
  },
  "γλυκύς": {
    "inflected_forms": [
      "γλύκιον",
      "νέκταρ",
      "ὕπνος",
      "ἵμερον"
    ],
    "definition": "γλυκύς, ύ. Comp. γλυκίων, γλύκιον Α249, Β453, Λ13,\n   Σ109: ι34.\n1. Sweet or pleasant to the taste: νέκταρ Α598.\n2. Generally, sweet, pleasant: ὕπνος Α610, ἵμερον Γ139.\n   Cf. Β71, Γ446, Ξ328, Ψ232: αἰών ε152. Cf. β395,\n   η289, θ445, ι333, κ31 = ν282, κ548, μ338, ο7, σ188,\n   199, τ49, χ500, ψ342.--In comp. Α249, Β453 = Λ13,\n   Σ109: ι34.",
    "headword_normalized": "γλυκυσ"
  },
  "γλυφίς": {
    "inflected_forms": [],
    "definition": "γλυφίς, ίδος, ἡ [γλύφω, to cut out, carve. Cf.\n   γλαφυρός]. App., the notch in an arrow to receive\n   the string. In pl. (poss. referring to a double\n   notch (i.e. two notches at right angles)) Δ122:\n   φ419.",
    "headword_normalized": "γλυφισ"
  },
  "γλῶσσα": {
    "inflected_forms": [
      "ἐμέμικτο"
    ],
    "definition": "γλῶσσα, ης, ἡ.\n1. The tongue Α249, Β489, Ε74, 292, Π161, Ρ618, Υ248.--\n   Of the tongues of sacrificial victims γ332, 341.\n2. A tongue or language Β804: τ175.--Language, speech:\n   γ. ἐμέμικτο Δ438.",
    "headword_normalized": "γλωσσα"
  },
  "γλωχίς": {
    "inflected_forms": [
      "ἔκαμψαν"
    ],
    "definition": "γλωχίς, ῖνος [cf. τανυγλώχις]. App., a tongue forming\n   one of the ends of the ζυγόδεσμον or yoke-fastening,\n   the ζ. being wound round the pole criss-cross,\n   keeping the portion with the tongue the longer, and\n   the tongue being tucked in under its portion after\n   that portion had been wound over, and had so\n   secured, the end of the other and shorter portion:\n   ὑπὸ γλωχῖνα δ’ ἔκαμψαν Ω274 (ὑπό advbl.).",
    "headword_normalized": "γλωχισ"
  },
  "γναθμός": {
