  "ἐφάλλομαι": {
    "inflected_forms": [
      "ἐπιάλμενος",
      "ἐπᾶλτο",
      "ἐπάλμενος",
      "ἐπιάλμενον",
      "Μενελάῳ"
    ],
    "definition": "†ἐφάλλομαι [ἐφ-, ἐπι- (11) (12)]. 3 sing. aor. ἐπᾶλτο\n   Ν643, Φ140. Pple. ἐπιάλμενος ω320. ἐπάλμενος Η260,\n   Λ421, 489, Μ404, Ν529, 531: ξ220. Acc. masc.\n   ἐπιάλμενον Η15. Pl. masc. ἐπάλμενοι χ305.\n1. To leap or spring to or towards a person: κύσσε μιν\n   ἐπιάλμενος ω320.\n2. In hostile sense, to leap or spring at or upon a\n   foe: οὔτασεν ἐπάλμενος Λ421. Cf. Η260, Μ404, Ν529,\n   531: ξ220.--Of birds of prey χ305.\n3. To leap or spring at or upon (a foe). With dat.:\n   Μενελάῳ Ν643. Cf. Λ489, Φ140.\n4. To leap or spring on to, mount. With genit.: ἵππων\n   ἐπιάλμενον (just as he had ...) Η15.",
    "headword_normalized": "εφαλλομαι"
  },
  "ἔφαλος": {
    "inflected_forms": [],
    "definition": "ἔφαλος, ον [ἐφ-, ἐπι- (2) + ἅλς]. On the seashore.\n   Epithet of cities Β538, 584.",
    "headword_normalized": "εφαλοσ"
