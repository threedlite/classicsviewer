  "κατευνάω": {
    "inflected_forms": [
      "κατευνήσαιμι"
    ],
    "definition": "κατευνάω [κατ-, κατα- (5)].\n1. To lay to rest, cause to sleep: ἄλλον κε θεῶν\n   κατευνήσαιμι Ξ245. Cf. Ξ248.\n2. In pass., to be laid, lie down, to rest: τὸν ἐπὴν\n   κατευνηθέντα ἴδησθε δ414. Cf. δ421.",
    "headword_normalized": "κατευναω"
  },
  "κατεφάλλομαι": {
    "inflected_forms": [
