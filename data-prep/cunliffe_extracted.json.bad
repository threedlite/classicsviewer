  "ἀνύω": {
    "inflected_forms": [],
    "definition": "ἀνύω [cf. next]. 3 sing. aor. ἤνῠσε δ357, ω71. 3 sing.\n   opt. ἀνύ̆σειε ο294. Fut. infin. pass. ἀνύσσεσθαι\n   π373. (ἀπ-, δι-, ἐξ-.)\n1. To effect, accomplish: ἀνύσσεσθαι τάδε ἔργα π373.--\n   To effect one's purpose Δ56.\n2. To consume: ἐπεί σε φλὸξ ἤνυσεν ω71.\n3. To pass over, traverse: θαλάσσης ὕδωρ ο294.--To\n   perform a voyage δ357.",
    "headword_normalized": "ανυω"
  },
  "ἄ̄νω": {
    "inflected_forms": [
