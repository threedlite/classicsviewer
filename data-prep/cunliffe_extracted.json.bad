  "παρήϊον": {
    "inflected_forms": [],
    "definition": "παρήϊον, τό [cf. παρειαί].\n1. The cheek Ψ690: τ208.--In reference to wolves Π159.\n   --To a lion χ404.\n2. A cheek ornament for a horse: παρήϊον ἔμμεναι ἵππων\n   (general pl., 'for some horse') Δ142.",
    "headword_normalized": "παρηιον"
  },
  "πάρημαι": {
    "inflected_forms": [
      "παρήμενοι",
      "παρήμενος"
    ],
    "definition": "πάρημαι [παρ-, παρα- (2)].\n1. To sit by or beside a person: ὡς μή μοι τρύζητε\n   παρήμενοι Ι311. Cf. Ω652: α339, ν411, ξ375, ρ521,\n   σ231, τ209. --In reference to birds λ578.--With\n   dat., to sit by or beside: παρήμενός μοι τέρπειν\n   τ589.--To sit at, by, in the enjoyment of: δαιτὶ\n   παρήμενος α26. Cf. ρ456.--To abide, be, by or with:\n   σύεσσιν ν407.\n2. To sit idle, doing nothing, by or beside. With dat.:\n   νηυσὶ παρήμενος Α421, 488.",
    "headword_normalized": "παρημαι"
  },
  "παρηορίαι": {
    "inflected_forms": [],
    "definition": "παρηορίαι, αἱ [παρήορος]. The traces attaching the\n   παρήορος (see next (2)) Θ87, Π152.",
