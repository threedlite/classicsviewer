  "κωκύω": {
    "inflected_forms": [
      "ἔπειτα"
    ],
    "definition": "κωκύω.\n1. To cry out in grief or distress: κώκυσέν τ’ ἄρ’\n   ἔπειτα Σ37. Cf. Σ71, Τ284, Χ407, Ω200, 703: β361,\n   δ259, θ527, τ541.\n2. To make lament for: ἑὸν πόσιν ω295.",
    "headword_normalized": "κωκυω"
  },
  "κώληψ": {
    "inflected_forms": [
      "κώληπα"
    ],
    "definition": "κώληψ, ηπος. App., the hollow behind the knee: κόψ’\n   ὄπιθεν κώληπα Ψ726.",
    "headword_normalized": "κωληψ"
  },
  "κῶμα": {
    "inflected_forms": [
      "κάλυψα"
    ],
    "definition": "κῶμα, τό [κω-, κοιμάω]. Sleep, slumber: αὐτῷ περὶ κῶμα\n   κάλυψα Ξ359. Cf. σ201.",
    "headword_normalized": "κωμα"
  },
  "κώπη": {
    "inflected_forms": [],
    "definition": "κώπη, ης, ἡ. A handle.\n1. The handle of a sword: ἄορ, ᾧ ἔπι κώπη ἀργυρέη θ403.\n   Cf. Α219: λ531.\n2. The handle of a κληΐς in sense (2) φ7.\n3. The handle of an oar, and hence, an oar: ἐμβαλέειν\n   κώπῃς ι489 = κ129. Cf. μ214.",
    "headword_normalized": "κωπη"
  },
  "κωπήεις": {
