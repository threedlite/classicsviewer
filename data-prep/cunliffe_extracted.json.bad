  "κρατερῶς": {
    "inflected_forms": [
      "ἐμάχοντο",
      "ἀγόρευσεν",
      "ἐνεμέσσα"
    ],
    "definition": "κρατερῶς [adv. fr. κρατερός]. With or by the exercise\n   of strength or force, violently, with violence:\n   ἐμάχοντο Μ152: κὰδ δ’ ἔβαλε κ. δ344 = ρ135.--In\n   reference to speech, with vehemence, right out,\n   without weighing one's words: ἀγόρευσεν Θ29 = Ι694.\n   Cf. Ι431.--To defence or resistance, stoutly,\n   staunchly Λ410, Ν56, Ο666, Π501 = Ρ559.--To\n   indignation, highly, intensely: κ. ἐνεμέσσα Ν16 =\n   353.",
    "headword_normalized": "κρατερωσ"
  },
  "κρά̄τεσφι": {
