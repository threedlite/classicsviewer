  "θέσκελος": {
    "inflected_forms": [
      "ἔργα",
      "αὐτῷ"
    ],
    "definition": "θέσκελος [the first element seems to be the same as in\n   θέσ-φατος].\n1. App., marvellous, wondrous, or the like: ἔργα Γ130:\n   λ374, 610.\n2. So in neut. θέσκελον as adv., marvellously, in\n   wondrous wise: ἔϊκτο θέσκελον αὐτῷ Ψ107.",
    "headword_normalized": "θεσκελοσ"
  },
  "θεσμός": {
