  "εὐφραίνω": {
    "inflected_forms": [
      "εὐφρανέειν",
      "εὐφρῆναι",
      "ἐϋφρανέω",
      "εὔφρηνε",
      "ἐϋφρήνῃς"
    ],
    "definition": "εὐφραίνω, ἐϋφραίνω [εὔφρων]. Fut. ἐϋφρανέω Η297. Infin.\n   εὐφρανέειν Ε688. 3 sing. aor. εὔφρηνε Ω102. 2 sing.\n   subj. ἐϋφρήνῃς Η294. Infin. εὐφρῆναι Ρ28.\n1. To gladden, rejoice, cheer, comfort Ε688, Η294, 297,\n   Ρ28, Ω102 (gave her kindly welcome): ν44, υ82.\n2. In pass., to have pleasure, make merry, enjoy\n   oneself: εὐφραίνεσθαι ἕκηλον β311.",
    "headword_normalized": "ευφραινω"
  },
  "ἐϋφρονέων": {
