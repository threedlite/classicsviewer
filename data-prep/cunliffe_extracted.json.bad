      "τίθει",
      "θήσω",
      "θήσεις",
      "θήσει",
      "θήσετε",
      "θήσουσι",
      "θήσειν",
      "ἔθηκα",
      "ἔθηκας",
      "ἔθηκε",
      "θῆκε",
      "ἔθηκαν",
      "θῆκαν",
      "θείω",
      "θήῃς",
      "θείομεν",
      "θείην",
      "θείης",
      "θείη",
      "θεῖεν",
