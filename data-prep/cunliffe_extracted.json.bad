  "βόσκω": {
    "inflected_forms": [
      "βοσκομενάων"
    ],
    "definition": "βόσκω. 2 sing. fut. βοσκήσεις ρ559. 3 pl. pa. iterative\n   pass. βοσκέσκοντο μ355.\n1. To feed, tend (cattle, etc.) Ο548: ξ102.\n2. To feed, nourish, support: γαῖα ἀνθρώπους λ365. Cf.\n   ι124, μ97, ξ325 = τ294.--To fill or stuff (one's\n   belly) ρ228, 559, σ364.\n3. In pass., of cattle, etc., to feed, graze: ξύλοχον\n   κάτα βοσκομενάων Ε162. Cf. Π151, Ρ62, Υ223: δ338 =\n   ρ129, λ108, μ128, 355, ξ104, φ49.--Of birds, to feed\n   Ο691.",
    "headword_normalized": "βοσκω"
  },
  "βοτά": {
    "inflected_forms": [
      "βοτοῖσιν"
    ],
    "definition": "βοτά, τά [βόσκω]. Grazing beasts, beasts of the herd:\n   ἀρδμὸς πάντεσσι βοτοῖσιν Σ521.",
    "headword_normalized": "βοτα"
  },
  "βοτάνη": {
