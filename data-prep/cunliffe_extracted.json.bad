  "γναμπτός": {
    "inflected_forms": [
      "ἕλικας",
      "νόημα"
    ],
    "definition": "γναμπτός, ή, όν [γνάμπτω].\n1. Bent, curved: ἕλικας Σ401: ἀγκίστροισιν δ369 = μ332.\n2. Fig., that can be bent or influenced: νόημα Ω41.\n3. As epithet of the limbs, flexible, lissom Λ669,\n   Ω359: λ394, ν398, 430, φ283.--Sim. of jaws, moving\n   freely in their sockets Λ416.",
    "headword_normalized": "γναμπτοσ"
  },
  "γνάμπτω": {
    "inflected_forms": [],
    "definition": "†γνάμπτω [= κνάμπτω]. 3 sing. aor. γνάμψε. (ἀνα-, ἐπι-,\n   περι-.) To bend: ἐν γόνυ γνάμψεν (app., crooked his\n   knee round the other's leg) Ψ731.",
    "headword_normalized": "γναμπτω"
