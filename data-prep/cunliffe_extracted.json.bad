  "δῑνήεις": {
    "inflected_forms": [],
    "definition": "δῑνήεις, εντος [δίνη]. Eddying, whirling. Epithet of\n   rivers. Of the Lycian Xanthus Β877, Ε479.--Of the\n   Trojan Xanthus (Scamander) Θ490, Ξ434 = Φ2 = Ω693,\n   Φ125, 206, 332, Χ148. --Of other rivers Υ392: ζ89,\n   λ242.",
    "headword_normalized": "δινηεισ"
  },
  "δῑνωτός": {
    "inflected_forms": [],
    "definition": "δῑνωτός, ή, όν [δινόω fr. δῖνος = δίνη]. (Cf.\n   ἀμφιδινέω.)\n1. App., adorned with inlaid circles or spirals of a\n   precious material Γ391: τ56.\n2. App., ornamented with rings or round pieces of\n   specified materials Ν407.",
    "headword_normalized": "δινωτοσ"
