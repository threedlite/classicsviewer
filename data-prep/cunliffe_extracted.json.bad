  "ἐπηετανός": {
    "inflected_forms": [],
    "definition": "ἐπηετανός, όν [prob. ἐπ-, ἐπι- (16) + ηε- = αἰεί +\n   suff. -τανος. 'Lasting for ever'].\n1. Never-failing, always available: γάλα δ89.--\n   Unfailing, constant, regularly afforded or given:\n   κομιδή θ233, σῖτον σ360.--Ever-flowing, always full:\n   πλυνοί ζ86, ἀρδμοί ν247.\n2. In neut. sing. ἐπηετανόν as adv., in never-failing\n   abundance: ἐ. ἔχουσιν κ427. Cf. η99.--Ever, all the\n   year round: γανόωσαι η128.",
    "headword_normalized": "επηετανοσ"
  },
  "ἐπήϊξα": {
    "inflected_forms": [],
    "definition": "ἐπήϊξα, aor. ἐπαΐσσω.",
    "headword_normalized": "επηιξα"
