  "οἰέτης": {
    "inflected_forms": [],
    "definition": "οἰέτης [ὀ = ἀ- + -ι- (app. representing lengthening\n   before Ϝ) + (Ϝ)έτος]. Of horses, of the same age,\n   one in years Β765.",
