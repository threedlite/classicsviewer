  "οἰδάνω": {
    "inflected_forms": [
      "νόον"
    ],
    "definition": "οἰδάνω [οἰδέω]. To cause to swell. Fig.: χόλος, ὅς τε\n   καὶ ἄλλων οἰδάνει νόον Ι554.--Sim. in pass.:\n   οἰδάνεταί μοι κραδίη χόλῳ (swells with ... ) Ι646.",
    "headword_normalized": "οιδανω"
  },
  "οἰδέω": {
