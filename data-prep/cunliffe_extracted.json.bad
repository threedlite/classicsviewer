  "ὀλβιοδαίμων": {
    "inflected_forms": [
      "ὀλβιόδαιμον"
    ],
    "definition": "ὀλβιοδαίμων [ὄλβιος + δαίμων]. Happy in the protection\n   and aid of a δαίμων, happy, fortunate. In voc.\n   ὀλβιόδαιμον Γ182.",
    "headword_normalized": "ολβιοδαιμων"
