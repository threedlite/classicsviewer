  "συνήορος": {
    "inflected_forms": [],
    "definition": "συνήορος, ὁ [συναείρω. Cf. παρήορος, τετράοροι].\n   Something linked or associated with something else,\n   an accompaniment: φόρμιγγος, ἣ δαιτὶ συνήορός ἐστιν\n   θ99.",
    "headword_normalized": "συνηοροσ"
  },
