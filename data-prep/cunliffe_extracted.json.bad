    "headword_normalized": "φυζακινοσ"
  },
  "φυή": {
    "inflected_forms": [],
    "definition": "φυή, ῆς, ἡ [φυ-, φύω]. One's bodily growth or\n   development, one's form or figure (commonly\n   connoting comeliness): οὐ δέμας οὐδὲ φυήν (the two\n   words difficult to distinguish) Α115, εἶδός τε\n   μέγεθός τε φυήν τε Β58. Cf. Γ208, Χ370: ε212, ζ16,\n   152, η210, θ134, 168.",
    "headword_normalized": "φυη"
  },
  "φῡκιόεις": {
