  "ἐπείδω": {
    "inflected_forms": [
      "πολλά"
    ],
    "definition": "†ἐπείδω [ἐπ-, ἐπι- (11)]. Acc. sing. masc. aor. pple.\n   ἐπιδόντα. To look upon, behold: κακὰ πολλά Χ61.",
    "headword_normalized": "επειδω"
