  "ὀμφή": {
    "inflected_forms": [],
    "definition": "ὀμφή, ῆς, ἡ. A voice. Always of a divine voice or\n   inspiration: ἐπισπόμενοι θεοῦ ὀμφῇ γ215 = π96. Cf.\n   Β41, Υ129.",
    "headword_normalized": "ομφη"
  },
  "ὁμώνυμος": {
