  "πτολίπορθος": {
    "inflected_forms": [],
    "definition": "πτολίπορθος, ον [πτόλις + πορθέω]. Sacker of cities.\n   Epithet of Odysseus Β278, Κ363: θ3, ι530, ξ447,\n   π442, σ356, χ283, ω119.--Of OÃ¯leus Β728.--Of Enyo\n   Ε333.--Of Achilles Θ372 = Ο77, Φ550, Ω108.--Of Ares\n   Υ152.--Of Otrynteus Υ384.",
    "headword_normalized": "πτολιπορθοσ"
  },
  "πτόλις": {
