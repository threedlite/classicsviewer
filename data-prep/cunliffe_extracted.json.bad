    "definition": "ὁπποῖος. See ὁποῖος.",
    "headword_normalized": "οπποιοσ"
  },
  "ὁππόσε": {
    "inflected_forms": [],
    "definition": "ὁππόσε. Whithersoever. With subj. in a relative\n   sentence corresponding to sentences with εἰ (4):\n   ὁππόσ’ ἐπέλθω ξ139 (see Table at end (II) (D) (3)).",
    "headword_normalized": "οπποσε"
  },
  "ὁππόσος": {
    "inflected_forms": [],
    "definition": "ὁππόσος. See ὁπόσος.",
