  "πολυπαίπαλος": {
    "inflected_forms": [],
    "definition": "πολυπαίπαλος [πολυ-, πολύς + παιπάλη, fine flour, fig.\n   of subtlety or wiliness]. Full of wiles, crafty:\n   Φοίνικες ο419.",
    "headword_normalized": "πολυπαιπαλοσ"
  },
  "πολυπά̄μων": {
    "inflected_forms": [],
    "definition": "πολυπά̄μων, ονος [πολυ-, πολύς + πάομαι, to acquire].\n   Of many possessions, wealthy Δ433.",
    "headword_normalized": "πολυπαμων"
  },
  "πολυπενθής": {
    "inflected_forms": [],
    "definition": "πολυπενθής, έος [πολυ-, πολύς + πένθος]. Full of\n   sorrows, sorrowful, woeful Ι563: ξ386, ψ15.",
    "headword_normalized": "πολυπενθησ"
  },
  "πολυπῖδαξ": {
    "inflected_forms": [],
    "definition": "πολυπῖδαξ, ακος [πολυ-, πολύς + πῖδαξ]. With many\n   springs, many-fountained. Epithet of Mount Ida Θ47,\n   Ξ157, Ο151, etc.",
    "headword_normalized": "πολυπιδαξ"
  },
  "πολύπικρος": {
    "inflected_forms": [],
    "definition": "πολύπικρος [πολυ-, πολύς + πικρός]. In neut. pl. as\n   adv., in right bitter fashion π255.",
    "headword_normalized": "πολυπικροσ"
  },
  "πολύπλαγκτος": {
    "inflected_forms": [],
    "definition": "πολύπλαγκτος [πολυ-, πολύς + πλαγκτός]. Tossed about or\n   roving from shore to shore ρ425, υ195. --Absol.\n   ρ511.--Of the wandering wind Λ308.",
    "headword_normalized": "πολυπλαγκτοσ"
  },
  "πολύπτυχος": {
    "inflected_forms": [],
    "definition": "πολύπτυχος, ον [πολυ-, πολύς + πτυχ-, πτύξ]. With many\n   clefts or glens. Epithet of Olympus Θ411, Υ5.--Of\n   Mount Ida Φ449, Χ171.",
    "headword_normalized": "πολυπτυχοσ"
  },
  "πολύπῡρος": {
    "inflected_forms": [],
    "definition": "πολύπῡρος, ον [πολυ-, πολύς + πυρός]. Rich in wheat:\n   νῆσος ο406.--Of places Λ756, Ο372: ξ335 = τ292,\n   π396.",
    "headword_normalized": "πολυπυροσ"
  },
  "πολύρρην": {
    "inflected_forms": [],
    "definition": "πολύρρην (πολύϜρην) [πολυ-, πολύς + Ϝρήν. See ἄρνα. Cf.\n   πολύαρνι]. Rich in sheep Ι154 = 296.",
