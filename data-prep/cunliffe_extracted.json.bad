  },
  "ἠΰκομος": {
    "inflected_forms": [],
    "definition": "ἠΰκομος, ον [ἠϋ-, εὐ- (5) + κόμη]. With beautiful hair,\n   fair-tressed. Epithet of goddesses and women. Of\n   Leto Α36, Τ413: λ318.--Of Thetis Δ512, Π860.--Of\n   Athene Ζ92, 273, 303.--Of Here Κ5.--Of Calypso θ452,\n   μ389.--Of Briseïs Β689.--Of Helen Γ329 = Η355 = Θ82,\n   Ι339, Λ369, 505, Ν766.--Of Niobe Ω602.--μητέρος\n   Ω466.",
    "headword_normalized": "ηυκομοσ"
  },
  "ἠΰς": {
