    "headword_normalized": "υψικαρηνοσ"
  },
  "ὑψίκερως": {
    "inflected_forms": [],
    "definition": "ὑψίκερως [ὕψι + κέρας]. High-horned: ὑψίκερων ἔλαφον\n   κ158.",
