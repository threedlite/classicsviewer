  },
  "λᾶϊγξ": {
    "inflected_forms": [],
    "definition": "λᾶϊγξ, ϊγγος, ἡ [λᾶας]. A pebble: ἧχι λάϊγγας\n   ἀποπλύνεσκε θάλασσα ζ95. Cf. ε433.",
    "headword_normalized": "λαιγξ"
  },
  "λαῖλαψ": {
    "inflected_forms": [
      "τύπτων",
      "πολλήν",
      "τείνῃ"
    ],
    "definition": "λαῖλαψ, απος, ἡ.\n1. A furious wind, a storm of wind, a tempest: βαθείῃ\n   λαίλαπι τύπτων Λ306. Cf. Λ747, Μ375, Π384, Υ51: ω42.\n2. Furious wind, storm, tempest: ἄγει λαίλαπα πολλήν\n   Δ278. Cf. Ρ57: ἄνεμος (Ζέφυρος) λαίλαπι θύων (in\n   storm) μ400, 426. Cf. ι68 = μ314, μ408.\n3. App., an accompaniment of a storm, a storm-cloud:\n   ὅτε τε Ζεὺς λαίλαπα τείνῃ Π365.",
    "headword_normalized": "λαιλαψ"
  },
  "λαιμός": {
    "inflected_forms": [
      "τύψεν"
    ],
    "definition": "λαιμός, οῦ, ὁ. The throat: Ἀφαρῆα λαιμὸν τύψεν Ν542.\n   Cf. Ν388, Σ34: χ15.--More specifically, the gullet\n   Τ209.",
    "headword_normalized": "λαιμοσ"
  },
