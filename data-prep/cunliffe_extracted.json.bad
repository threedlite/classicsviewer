  "κορυθαίολος": {
    "inflected_forms": [],
    "definition": "κορυθαίολος [κορυθ-, κόρυς + αἰόλος]. With glancing\n   helm. Epithet of Hector Β816, Γ83, Ε680, Ζ263, Η158,\n   Λ315, Μ230, Ο246, Ρ96, Σ21, Τ134, Υ430, Χ249, etc.--\n   Of Ares Υ38.",
    "headword_normalized": "κορυθαιολοσ"
