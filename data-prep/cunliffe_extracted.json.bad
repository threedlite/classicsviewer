  "περιτροπέω": {
    "inflected_forms": [
      "ἐνιαυτός"
    ],
    "definition": "περιτροπέω [περι- (1) (2)].\n1. To surround and drive (into a compact flock): μῆλα\n   ι465.\n2. In pple. of the revolving year (cf. περιτέλλομαι):\n   εἴνατος περιτροπέων ἐνιαυτός Β295.",
    "headword_normalized": "περιτροπεω"
  },
  "περίτροχος": {
    "inflected_forms": [
      "σῆμα"
    ],
    "definition": "περίτροχος [περιτρέχω]. Round, circular: σῆμα Ψ455.",
    "headword_normalized": "περιτροχοσ"
  },
  "περιφαίνομαι": {
    "inflected_forms": [
      "περιφαινομένοιο"
    ],
    "definition": "περιφαίνομαι [περι- (1)]. In pple.\n1. Seen from all round, conspicuous: ὄρεος\n   περιφαινομένοιο Ν179.\n2. = περίσκεπτος. Absol.: ἐν περιφαινομένῳ (in,\n   bordering upon, a clearing) ε476.",
    "headword_normalized": "περιφαινομαι"
  },
  "περιφραδέως": {
    "inflected_forms": [
      "ὤπτησαν"
    ],
    "definition": "περιφραδέως [adv. fr. περιφραδής, fr. περι- (6) +\n   φραδής]. With great care, carefully: ὤπτησαν Α466 =\n   Β429 = Η318 = Ω624: = ξ431, τ423.",
    "headword_normalized": "περιφραδεωσ"
  },
  "περιφράζομαι": {
    "inflected_forms": [],
    "definition": "περιφράζομαι [περι- (5)]. To take counsel concerning\n   (something), devise, contrive: περιφραζώμεθα νόστον\n   α76.",
    "headword_normalized": "περιφραζομαι"
  },
  "περίφρων": {
    "inflected_forms": [],
    "definition": "περίφρων, ονος [περι- (6) + φρήν]. Voc. περίφρον π435,\n   σ245, 285, φ321. Of great good sense, wise, sage,\n   prudent. Epithet of women. Of Aegialeia Ε412.--Of\n   Penelope α329, δ787, ε216, ξ373, etc.--Of Arete\n   λ345.--Of Eurycleia τ357, 491 = υ134, φ381.",
    "headword_normalized": "περιφρων"
  },
  "περιφύω": {
    "inflected_forms": [
      "περιφῦναι"
    ],
    "definition": "†περιφύω [περι- (1)]. Aor. pple. περιφύς π21, ω320.\n   Fem. περιφῦσα τ416. Infin. περιφῦναι ω236. To grow\n   round; hence, to throw one's arms round a person,\n   embrace him: Τηλέμαχον κύσεν περιφύς π21. Cf. ω320.\n   --To throw one's arms round, embrace. With dat.:\n   περιφῦσ’ Ὀδυσῆϊ τ416.--With acc.: κύσσαι καὶ\n   περιφῦναι ἑὸν πατέρα ω236.",
    "headword_normalized": "περιφυω"
  },
  "περιχέω": {
    "inflected_forms": [
      "περιχεύεται",
      "περιχεύας"
    ],
    "definition": "†περιχέω [περι- (1)]. 3 sing. aor. περίχευε γ437, η140,\n   ψ162. 3 sing. subj. περιχεύῃ γ426. Pple. περιχεύας\n   Κ294, Φ319: γ384. 3 sing. aor. subj. mid.\n   περιχεύεται ζ232, ψ159.\n1. To shed or spread something round or over another\n   thing: χέραδος περιχεύας Φ319.--To shed round. With\n   dat.: ἠέρ’, ἥν οἱ περίχευεν Ἀθήνη η140.--So of\n   something immaterial: τῷ περίχευε χάριν ψ162.\n2. To spread round, put round as a covering or\n   adornment. With dat.: χρυσὸν κέρασιν περιχεύας Κ294:\n   = γ384. Cf. γ426, 437.--So of spreading one metal on\n   the ground of another in, app., some process of\n   enamel: ὡς ὅτε τις χρυσὸν περιχεύεται ἀργύρῳ ζ232 =\n   ψ159.",
    "headword_normalized": "περιχεω"
  },
  "περιχώομαι": {
    "inflected_forms": [
      "περιχώσατο"
    ],
    "definition": "†περιχώομαι [περι- (5)]. 3 sing. aor. περιχώσατο. To be\n   angered or wroth, conceive anger or wrath, about or\n   on account of. With genit.: παλλακίδος μοι\n   περιχώσατο Ι449. Cf. Ξ266.",
    "headword_normalized": "περιχωομαι"
  },
  "περιωπή": {
    "inflected_forms": [],
    "definition": "περιωπή, ῆς, ἡ [περι- (1) + ὀπ-. See ὁράω]. A spot\n   commanding a view on all sides, a look-out place:\n   ἀνήϊον ἐς περιωπήν κ146. Cf. Ξ8, Ψ451.",
    "headword_normalized": "περιωπη"
  },
  "περιώσιος": {
    "inflected_forms": [],
    "definition": "περιώσιος [περι- + an uncertain second element]. In\n   neut. sing. περιώσιον as adv., beyond measure:\n   θαυμάζειν π203. Cf. Δ359.",
    "headword_normalized": "περιωσιοσ"
  },
  "περκνός": {
    "inflected_forms": [
      "καλέουσιν"
    ],
    "definition": "περκνός (ὑποπερκάζω). App., dappled, spotted with dark:\n   αἰετόν, ὃν καὶ περκνὸν καλέουσιν Ω316.",
    "headword_normalized": "περκνοσ"
  },
  "πέρνημι": {
    "inflected_forms": [
      "πέρνασκε",
      "ἵκει",
      "τηλεδαπάων"
    ],
    "definition": "πέρνημι [cf. περάω]. 3 sing. pa. iterative πέρνασκε\n   Ω752. To export for sale, sell to foreign buyers:\n   πολλὰ Φρυγίην κτήματα περνάμεν’  ἵκει Σ292.--To sell\n   into slavery: περνὰς νήσων ἔπι τηλεδαπάων Χ45. Cf.\n   Ω752.",
    "headword_normalized": "περνημι"
  },
  "περονάω": {
    "inflected_forms": [],
    "definition": "περονάω [περόνη].\n1. To pierce, transfix Η145, Ν397.\n2. In mid., to fasten (a garment) about one with a\n   περόνη (or ἐνετή): ἐνετῇσι κατὰ στῆθος περονᾶτο\n   [ἑανόν] Ξ180. Cf. Κ133.",
    "headword_normalized": "περοναω"
  },
  "περόνη": {
    "inflected_forms": [],
    "definition": "περόνη, ης, ἡ [πείρω]. Something for piercing; a clasp,\n   buckle, or brooch for fastening a garment about one.\n   In connexion with a woman's dress Ε425: σ293.--With\n   a man's τ226, 256.",
    "headword_normalized": "περονη"
  },
  "πέρσα": {
    "inflected_forms": [],
    "definition": "πέρσα, aor. πέρθω.",
    "headword_normalized": "περσα"
