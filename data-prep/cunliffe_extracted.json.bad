  "προείδω": {
    "inflected_forms": [
      "προΐδωσι",
      "προΐδωνται",
      "προϊδών",
      "προϊδόντες"
    ],
    "definition": "†προείδω [προ- (1) (3)]. 3 pl. aor. subj. προΐδωσι\n   Ρ756. Pple. προϊδών Χ275: δ396, ε393. Pl. προϊδόντες\n   Σ527. 3 pl. aor. subj. mid. προΐδωνται ν155.\n1. To direct one's glance forward, look forward or\n   before one: ὀξὺ μάλα προϊδών ε393. Cf. Χ275.\n2. To catch sight of, descry, see: τὰ προϊδόντες Σ527.\n   Cf. Ρ756.--In mid. ν155.\n3. To catch sight of beforehand: μή πώς με προϊδὼν\n   ἀλέηται (catching sight of me before the time) δ396.",
    "headword_normalized": "προειδω"
  },
  "προέμεν": {
    "inflected_forms": [],
    "definition": "προέμεν, aor. infin. προΐημι.",
