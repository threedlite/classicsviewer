  "κυβερνήτης": {
    "inflected_forms": [],
    "definition": "κυβερνήτης, ὁ [κυβερνάω]. The steersman of a ship: νῆας\n   ἄνεμός τε κυβερνῆταί τ’ ἴθυνον ι78 = ξ256. Cf. Τ43,\n   Ψ316: γ279, λ10 = μ152, μ217, 412.",
    "headword_normalized": "κυβερνητησ"
  },
  "κυβιστάω": {
