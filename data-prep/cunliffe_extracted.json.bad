  },
  "λαιψηρός": {
    "inflected_forms": [
      "κέλευθα"
    ],
    "definition": "λαιψηρός [= αἰψηρός; or perh. conn. with λαῖλαψ].\n   Swift, rushing: ἀνέμων λαιψηρὰ κέλευθα Ξ17, Ο620.--\n   Of the arrows of Apollo, quickly reaching the mark,\n   swift Φ278.--Of a person, swift, nimble Φ264.--\n   Epithet of the knees Κ358, Ο269, Υ93, Χ24, 144, 204.",
    "headword_normalized": "λαιψηροσ"
  },
  "λακτίζω": {
