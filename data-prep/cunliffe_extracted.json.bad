  "προφαίνω": {
    "inflected_forms": [
      "προφανέντε",
      "προπέφανται",
      "γεφύρας"
    ],
    "definition": "προφαίνω [προ- (1)]. Impf. act. and pass. προὔφαινον,\n   προὐφαινόμην. Acc. sing. masc. aor. pple. pass.\n   προφανέντα ω160. Nom. dual προφανέντε Ω332. Acc.\n   προφανέντε Θ378, Ρ487. 3 sing. pf. προπέφανται Ξ332.\n1. To show forth, show, display: τέραα μ394.\n2. Intrans., to give forth light, be visible: οὐδὲ\n   σελήνη προὔφαινεν ι145.\n3. In pass., to come into view, appear, make one's\n   appearance, present oneself: προφανέντε ἀνὰ\n   πτολέμοιο γεφύρας Θ378, τὰ προπέφανται ἅπαντα (lie\n   open to view) Ξ332. Cf. Ρ487, Ω332: ν169, ω160.--\n   Impers.: οὐδὲ προὐφαίνετ’ ἰδέσθαι (there was not\n   light enough to see) ι143.",
    "headword_normalized": "προφαινω"
  },
  "πρόφασις": {
    "inflected_forms": [
      "ἑκάστη"
    ],
    "definition": "πρόφασις, ἡ [προ- (1) + φα-, φημί]. A profession or\n   declaration. Adverbially in acc., as the cause that\n   moves one, as the occasion (cf. ἐπίκλησις (2), χάρις\n   (2) (b)): κλαίουσα, ἐπὶ δὲ στενάχοντο γυναῖκες,\n   Πάτροκλον πρόφασιν, σφῶν δ’ αὐτῶν κήδε’ ἑκάστη Τ302\n   (i.e. his death was the immediate occasion, and each\n   had her own griefs as well).--With genit.: εὐνῆς\n   πρόφασιν (for the sake of ...) Τ262.",
    "headword_normalized": "προφασισ"
  },
  "προφερής": {
    "inflected_forms": [],
    "definition": "προφερής [προφέρω (with προ- (2)). 'Borne in front'].\n   Comp. προφερέστερος, -η, better, more skilled or\n   serviceable: ἐμεῖο προφερέστεροι φ134. Cf. Κ352:\n   θ221.--Superl. προφερέστατος, the best, the most\n   skilled: ἅλματι πάντων προφερέστατος ἦεν (at ..., in\n   ...) θ128.",
    "headword_normalized": "προφερησ"
  },
  "προφέρω": {
    "inflected_forms": [
      "μάστακα",
      "μένος",
      "ὀνείδεα",
      "Ἀφροδίτης",
      "προφέρονται"
    ],
    "definition": "προφέρω [προ- (1)].\n1. To bear or carry in a specified or indicated\n   direction or to a specified or indicated\n   destination: ὡς ὄρνις νεοσσοῖσι προφέρῃσι μάστακα\n   Ι323. Cf. Ζ346, Ρ121: υ64.\n2. To put forth, display: κρατερὸν μένος Κ479.--To\n   bring forth, utter (abuse): ὀνείδεα Β251.--To cast\n   in one's teeth: δῶρ’ Ἀφροδίτης Γ64.--To offer\n   (battle) (cf. Λ529 cited under προβάλλω (1)). In\n   mid.: ἔριδα προφέρονται Γ7.--To display, engage in\n   (rivalry): ἔριδα προφέρουσαι ζ92.--So in mid. θ210.",
    "headword_normalized": "προφερω"
  },
  "προφεύγω": {
    "inflected_forms": [
