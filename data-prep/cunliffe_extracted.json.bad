  "ὑψίζυγος": {
    "inflected_forms": [],
    "definition": "ὑψίζυγος [ὕψι + ζυγόν. Cf. ζυγόν (2)]. Seated aloft.\n   Epithet of Zeus Δ166, Η69, Λ544, Σ185.",
    "headword_normalized": "υψιζυγοσ"
  },
  "ὑψικάρηνος": {
