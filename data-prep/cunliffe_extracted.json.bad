    "definition": "κόρυμβον, τό [κορ- as in κορυφή]. App. = ἄφλαστον: νηῶν\n   κόρυμβα Ι241.",
    "headword_normalized": "κορυμβον"
  },
  "κορύνη": {
    "inflected_forms": [],
    "definition": "κορύνη, ης, ἡ. A club used as one's weapon Η141, 143.",
    "headword_normalized": "κορυνη"
