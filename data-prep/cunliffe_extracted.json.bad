  "ἐφέστιος": {
    "inflected_forms": [],
    "definition": "ἐφέστιος [ἐφ-, ἐπι- (2) + ἑστίη = ἱστίη. 'At the\n   hearth']. At home, in one's home: ἀπολέσθαι ἐ. γ234,\n   ἦλθεν ἐ. (has come home) ψ55.--In the home of\n   another: ἔμ’ ἐφέστιον ἤγαγε δαίμιον (brought me to\n   be her guest) η248.--Τρῶας ἐφέστιοι ὅσσοι ἔασιν (who\n   have homes, are householders (in the city)) Β125.",
    "headword_normalized": "εφεστιοσ"
  },
  "ἐφετμή": {
