  "βλάβω": {
    "inflected_forms": [
      "γούνατα",
      "ἀγορητής"
    ],
    "definition": "βλάβω [= βλάπτω]. To cause to fail or break down:\n   βλάβεται γούνατα Τ166: ν34.--To cause (a speaker) to\n   break down: βλάβεται λιγύς περ ἐὼν ἀγορητής Τ82.",
    "headword_normalized": "βλαβω"
