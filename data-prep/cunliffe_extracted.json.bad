      "ἰέναι",
      "ἐπιδοῦναι",
      "ἄλλῳ",
      "γένευ",
      "ἄλλο",
      "ἀπαλεξήσαιμι",
      "ὀϊστόν",
      "ὕφαινεν",
      "λαόν",
      "ἀνήρ",
      "ἀνῷγεν",
      "γένοιτο",
      "ἄλλοι",
      "ἄκουε",
      "ἄλλων",
      "ὁρᾶτο",
      "γέρα",
      "θεοί",
      "θεοῖς",
      "ἐσθλῶν",
      "δαμεῖεν",
      "ἀποκινήσασκεν",
