  "βόειος": {
    "inflected_forms": [],
    "definition": "βόειος, η, ον [βοῦς].\n1. Of an ox: δέρμα ξ24.\n2. Made from ox-hide Δ122: ω228.\n3. In fem. βοείη as sb.\n        a. A living ox's hide Σ582. --An ox-hide lately\n       stripped off χ364.--An ox-hide in process of\n       being dressed Ρ389.--A dressed ox-hide Λ843:\n       υ96.--A piece of dressed ox-leather Μ296.\n        b. A shield of ox-hide Ε452 = Μ425, Χ159.",
    "headword_normalized": "βοειοσ"
  },
  "βόεος": {
    "inflected_forms": [
      "ὄνθου"
    ],
    "definition": "βόεος = prec.\n1. Of an ox: ὄνθου Ψ777.\n2. Made from ox-hide Χ397, Ψ324.\n3. In fem. βοέη as sb.\n        a. An (undressed) ox-hide υ2, 142.\n        b. A shield of ox-hide Ρ492.",
    "headword_normalized": "βοεοσ"
  },
  "βοεύς": {
    "inflected_forms": [],
    "definition": "βοεύς, ὁ [βοῦς]. A strap of ox-leather (used for\n   hoisting a sail): ἕλκον ἱστία βοεῦσιν β426 = ο291.",
