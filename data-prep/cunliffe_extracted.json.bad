  "πικρός": {
    "inflected_forms": [
      "ὀϊστόν",
      "ὠδῖνας",
      "ῥίζαν"
    ],
    "definition": "πικρός, ή, -όν (in δ406 of two terminations) [prob.\n   πικ-, πευκ-. Cf. πευκεδανός].\n1. Sharppointed, sharp, keen, piercing: ὀϊστόν Δ118.\n   Cf. Δ134, Χ206, etc.: χ8.\n2. Of pain, acute, piercing, darting: ὠδῖνας Λ271.\n3. Pungent or bitter to the taste: ῥίζαν Λ846. Cf.\n   ε323.--Pungent to the smell: ὀδμήν δ406.\n4. Fig.: μὴ πικρὴν Αἴγυπτον ἵκηαι ρ448 (you prate of\n   Egypt. You will find yourself in a sorry sort of\n   Egypt, i.e. in trouble).",
    "headword_normalized": "πικροσ"
  },
  "πίλναμαι": {
    "inflected_forms": [
