  "θειλόπεδον": {
    "inflected_forms": [],
    "definition": "θειλόπεδον, τό [app. θείλη = εἵλη, the sun's warmth +\n   πέδον, the ground]. A warm spot in a vineyard in\n   which the grapes were left to be dried by the sun, a\n   'sun-trap' η123.",
    "headword_normalized": "θειλοπεδον"
  },
  "θεῖναι": {
