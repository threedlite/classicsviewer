  "προδάω": {
    "inflected_forms": [],
    "definition": "†προδάω [προ- (3)]. Aor. pple. προδαείς. To know\n   something beforehand: μή πώς με προδαεὶς ἀλέηται\n   (forming a suspicion) δ396.",
    "headword_normalized": "προδαω"
  },
  "προδοκή": {
    "inflected_forms": [
      "προδοκῇσιν"
    ],
    "definition": "προδοκή, ῆς, ἡ [προ- (1) + δοκ-, δέχομαι]. A place\n   where one may lie in wait, a lurking-place. In pl.:\n   δεδεγμένος ἐν προδοκῇσιν Δ107.",
    "headword_normalized": "προδοκη"
  },
  "πρόδομος": {
    "inflected_forms": [],
    "definition": "πρόδομος, ου, ὁ [προ- (2) + δόμος]. A space in front of\n   the door of the μέγαρον, app. the part of the line\n   of the αἴθουσα into which the door opened: εὗρεν ἐνὶ\n   προδόμῳ δέπα ο466. Cf. Ι473 (see θάλαμος (1) (a)).--\n   Used as a sleeping-place for visitors Ω673 (Priam\n   and the herald in Achilles's dwelling): = δ302\n   (Telemachus and Pisistratus in Menelaus's house)\n   (cf. Ω644: = δ297). Cf. ο5, υ1 (the disguised\n   Odysseus in his own house), 143 (the same in the\n   same).--A space in front of the door of the dwelling\n   of Eumaeus ξ5.",
    "headword_normalized": "προδομοσ"
  },
  "προεέργω": {
    "inflected_forms": [
      "ὁδεύειν"
    ],
    "definition": "προεέργω [προ- (2)]. To stand in front of someone and\n   debar (him from doing something). With infin.:\n   πάντας προέεργε ἐπὶ νῆας ὁδεύειν Λ569.",
    "headword_normalized": "προεεργω"
  },
  "προέηκα": {
    "inflected_forms": [],
    "definition": "προέηκα, aor. προΐημι.",
    "headword_normalized": "προεηκα"
