  "θαμά": {
    "inflected_forms": [
      "ἐβάζετε"
    ],
    "definition": "θαμά [adv. answering to θαμέες]. Often: ταῦτά με θ.\n   ἐβάζετε Π207. Cf. Ο470: α143, 209, δ178, 686, ο516,\n   π27, τ521.",
    "headword_normalized": "θαμα"
  },
  "θαμβέω": {
    "inflected_forms": [
      "Ἀχιλεύς"
    ],
    "definition": "θαμβέω [θάμβος].\n1. To wonder, be struck with wonder or astonishment:\n   θάμβησεν Ἀχιλεύς Α199. Cf. Γ398, Θ77, Ψ728 = 881,\n   Ω483, 484: θαμβήσασα βεβήκει α360 = φ354. Cf. α323,\n   δ638,  κ63, ω101.\n2. To wonder or marvel at: ὄρνιθας β155. Cf. π178,\n   ρ367.",
    "headword_normalized": "θαμβεω"
  },
  "θάμβος": {
    "inflected_forms": [
      "εἰσορόωντας"
    ],
    "definition": "θάμβος, τό. Genit. θάμβευς ω394. Wonder, astonishment,\n   amazement: θ. ἔχεν εἰσορόωντας Γ342. Cf. Δ79, Ψ815,\n   Ω482: γ372, ω394.",
    "headword_normalized": "θαμβοσ"
  },
  "θαμέες": {
    "inflected_forms": [
      "νέες",
      "ἀΐσσουσιν",
      "θαμειαί"
    ],
    "definition": "θαμέες. Nom. pl. fem. θαμειαί. Acc. θαμειάς.\n1. Set or standing closely together: ἔνθα θαμειαὶ\n   εἴρυντο νέες Σ68. Cf. Κ264, Μ296, Τ383 = Χ316:\n   ἀραρὼν θαμέσι σταμίνεσσιν ε252. Cf. μ92, ξ12.\n2. Coming, flying, falling, thick and fast: θαμέες\n   ἄκοντες ἀΐσσουσιν Λ552 = Ρ661, ὥς τε νιφάδες πίπτωσι\n   θαμειαί Μ278. Cf. Μ44, 287, Ξ422.\n3. Occurring at short intervals over a space, numerous:\n   πυραὶ καίοντο θαμειαί Α52.",
    "headword_normalized": "θαμεεσ"
  },
  "θαμίζω": {
    "inflected_forms": [
      "θαμίζεις"
    ],
    "definition": "θαμίζω [θαμά].\n1. To come often to, frequent, an indicated place:\n   πάρος γε μὲν οὔ τι θαμίζεις Σ386 = 425: ε88.\n2. To go about, ply one's vocation: ἅμα νηῒ θαμίζων\n   θ161.\n3. With pass. pple., to be accustomed to treatment of\n   an indicated kind: οὔ τι κομιζόμενος θάμιζεν (was\n   not wont to be (so) cared for) θ451.",
    "headword_normalized": "θαμιζω"
  },
  "θάμνος": {
    "inflected_forms": [
      "ἀμφικόμῳ"
    ],
    "definition": "θάμνος, ὁ [cf. θαμέες].\n1. A bush, shrub, small tree: θάμνῳ ὑπ’ ἀμφικόμῳ Ρ677.\n   Cf. Λ156, Χ191: δοιοὺς ὑπήλυθε θάμνους ε476, θάμνος\n   ἐλαίης (consisting of ...) ψ190. Cf. χ469\n2. In pl., a thicket: θάμνων ὑπεδύσετο ζ127. Cf. ε471,\n   η285.",
    "headword_normalized": "θαμνοσ"
  },
  "θάνατόνδε": {
    "inflected_forms": [
      "κιόντα"
    ],
    "definition": "θάνατόνδε [acc. of θάνατος + -δε (1)]. To one's death:\n   ὡς εἰ θ. κιόντα Ω328. Cf. Π693, Χ297.",
    "headword_normalized": "θανατονδε"
  },
  "θάνατος": {
    "inflected_forms": [
      "Θανάτοιο",
      "ἁλῶναι"
    ],
    "definition": "θάνατος, ου, ὁ [θαν-, θνῄσκω].\n1. Death Α60, Β302, Γ101, Ε68, Ι571, etc.: β100, γ236,\n   δ180, ι467, λ488, etc.\n2. Personified: Ὕπνῳ κασιγνήτῳ Θανάτοιο Ξ231. Cf. Π454,\n   672 = 682.\n3. A kind or mode of death: λευγαλέῳ θανάτῳ ἁλῶναι\n   Φ281: = ε312, πάντες στυγεροὶ θάνατοί [εἰσιν] μ341.\n   Cf. λ412, ο359, σ202, χ462, ω34.",
    "headword_normalized": "θανατοσ"
  },
  "θανέεσθαι": {
    "inflected_forms": [],
    "definition": "θανέεσθαι, fut. infin. θνῄσκω.",
