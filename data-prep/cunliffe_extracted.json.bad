      "αἱρεύμενοι",
      "αἱρήσεαι",
      "ἑλόμην",
      "εἵλευ",
      "εἵλετο",
      "ἕλετο",
      "ἑλόμεσθα",
      "εἵλοντο",
      "ἕλοντο",
      "ἕλωμαι",
      "ἕληται",
      "ἕλωνται",
      "ἕλευ",
      "ἑλέσθω",
      "ἕλεσθε",
      "ἡνία",
