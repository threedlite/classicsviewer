  "γουνάζομαι": {
    "inflected_forms": [
      "γουνάσομαι",
      "τοκήων",
      "ὕπερ",
      "μιν"
    ],
    "definition": "γουνάζομαι [γουν-, γόνυ. 'To clasp the knees, clasp by\n   the knees, in supplication.' Cf. γόνυ (3)]. Fut.\n   γουνάσομαι Α427. To supplicate, entreat. Retaining\n   the genitival construction of a vb. of taking hold,\n   and with the construction extended to something\n   appealed to: μή με γούνων γουνάζεο μηδὲ τοκήων Χ345.\n   --With this latter construction alone: τῶν ὄπιθέν σε\n   γουνάζομαι λ66.--With prepositional clauses\n   indicating what is appealed to: τῶν ὕπερ Ο665. Cf.\n   λ66, ν324.--With simple acc. of the person\n   entreated: γουνάσομαί μιν Α427. Absol. Λ130.",
    "headword_normalized": "γουναζομαι"
  },
  "γούνατος": {
    "inflected_forms": [],
    "definition": "γούνατος, γουνός, genit. γόνυ.",
    "headword_normalized": "γουνατοσ"
  },
  "γουνός": {
    "inflected_forms": [
      "ἀλωῇς"
    ],
    "definition": "γουνός [perh. fr. γονϜ-, γόνυ, in sense 'swell,'\n   'knoll,' and, in reference to a vineyard, etc., the\n   part best catching the sun, and therefore the most\n   fruitful]. γουνῷ (γουνὸν) ἀλωῇς Ι534, Σ57 = 438:\n   α193, λ193, ἐς γουνὸν Ἀθηνάων λ323 (here perh. the\n   reference is to the citadel).",
    "headword_normalized": "γουνοσ"
  },
  "γουνοῦμαι": {
    "inflected_forms": [
      "υἱόν"
    ],
    "definition": "γουνοῦμαι = γουνάζομαι. To supplicate, entreat: υἱόν\n   Ι583. Cf. Ο660, Φ74, Χ240: δ433, ζ149, χ312, 344.--\n   App., to supplicate (and at the same  time to vow to\n   do something): νεκύων κάρηνα ῥέξειν ... κ521, λ29.",
    "headword_normalized": "γουνουμαι"
  },
