  "κυανόπρῳρος": {
    "inflected_forms": [],
    "definition": "κυανόπρῳρος, ον [κύανος + πρῴρη]. Having the prow\n   ornamented with designs in κύανος. Epithet of ships\n   Ο693, Ψ852, 878: ι482, 539, κ127, λ6 = μ148, μ100,\n   354, ξ311, χ465.",
    "headword_normalized": "κυανοπρωροσ"
  },
  "κύανος": {
    "inflected_forms": [],
    "definition": "κύανος, ου, ὁ. Glass paste or enamel coloured with a\n   pigment doubtless to be identified with the pigment\n   of brilliant cobalt hue largely used in the palace\n   at Cnossus (see Sir Arthur Evans's The Palace of\n   Minos, 1921, vol. i. p. 534): θριγκὸς κυάνοιο η87.\n   Cf. Λ24, 35.",
    "headword_normalized": "κυανοσ"
  },
  "κῡανοχαίτης": {
    "inflected_forms": [
      "κυανοχαῖτα"
    ],
    "definition": "κῡανοχαίτης [κύανος + χαίτη]. Voc. κυανοχαῖτα Ο174,\n   201: ι528. Nom. κυανοχαῖτα (prob. orig. the voc.\n   turned into a nom.) Ν563, Ξ390. Dark-haired. Epithet\n   or a name of Poseidon Ν563, Ξ390, Ο174, 201, Υ144:\n   γ6, ι528, 536. --As epithet of a horse, dark-maned\n   Υ224.",
    "headword_normalized": "κυανοχαιτησ"
  },
  "κυανῶπις": {
