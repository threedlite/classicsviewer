  },
  "κάνεον": {
    "inflected_forms": [
      "κάνεον"
    ],
    "definition": "κάνεον, ου, τό. Also κάνειον κ355.\n1. A bread-basket, app. of wicker-work Ι217 = Ω626:\n   α147, θ69, π51, ρ335, 343 (the meat presumably from\n   another basket; see (2)), σ120, υ255.\n2. A similar basket for meat υ300.\n3. A similar basket for sacrificial meal γ442, δ761.\n4. A bread-basket of metal: χάλκειον κάνεον Λ630. Cf.\n   κ355.",
    "headword_normalized": "κανεον"
  },
  "καννεύσας": {
    "inflected_forms": [],
    "definition": "καννεύσας, contr. aor. pple. κατανεύω.",
    "headword_normalized": "καννευσασ"
  },
  "κανών": {
    "inflected_forms": [
      "κανόνεσσι",
      "ἀραρυῖαν"
    ],
    "definition": "κανών, όνος, ὁ. Dat. pl. κανόνεσσι Ν407.\n1. App., each of two pieces set inside a shield to keep\n   it in shape, one running from top to bottom and the\n   other pla ced horizontally, the middle portion of\n   the latter forming a handle: [ἀσπίδα] δύω κανόνεσσ’\n   ἀραρυῖαν Ν407. Cf. Θ193.\n2. In weaving, app., each of two horizontal rods to\n   which the lower ends of the threads of the warp\n   (μίτος) were attached, the even threads to one and\n   the odd to the other Ψ761.",
    "headword_normalized": "κανων"
  },
  "κάπ": {
    "inflected_forms": [],
    "definition": "κάπ. See κατά.",
    "headword_normalized": "καπ"
  },
  "κάπετος": {
    "inflected_forms": [],
    "definition": "κάπετος, ου, ἡ [app. (σ)κάπετος, fr. σκάπτω, to dig].\n1. A ditch surrounding a vineyard Σ564.\n2. A ditch in fortification Ο356.\n3. A grave Ω797.",
    "headword_normalized": "καπετοσ"
  },
  "κάπη": {
    "inflected_forms": [
      "κάπῃσιν"
    ],
    "definition": "κάπη, ης, ἡ. A horse's crib or manger: ἵππους κατέδησαν\n   ἐπὶ κάπῃσιν Θ434: δ40.",
    "headword_normalized": "καπη"
  },
  "καπνίζω": {
