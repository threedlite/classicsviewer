  "δείδοικα": {
    "inflected_forms": [
      "δειδιώς",
      "δείσας",
      "δειδίμεν",
      "δείσεσθαι",
      "δείδοικα",
      "δείδιμεν",
      "δεδίᾱσι",
      "ἐδείδιμεν",
      "δείδιθι",
      "δείδιτε",
      "δείσεται",
      "ἔδεισε",
      "δεῖσε",
      "ἐδείσατε",
      "δεῖσαν",
      "δείσῃ",
      "δείσειε",
