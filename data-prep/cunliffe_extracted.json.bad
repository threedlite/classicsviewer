  "ὁμοφρονέω": {
    "inflected_forms": [],
    "definition": "ὁμοφρονέω [ὁμόφρων]. To be of like mind with another\n   ζ183.--To feel with another, sympathize with him\n   ι456.",
    "headword_normalized": "ομοφρονεω"
  },
  "ὁμοφροσύνη": {
    "inflected_forms": [],
    "definition": "ὁμοφροσύνη, ης, ἡ [ὁμόφρων]. Oneness or likeness of\n   mind, concord: ὁμοφροσύνην ὀπάσειαν ζ181.--So in\n   pl.: ἥδ’ ὁδὸς καὶ μᾶλλον ὁμοφροσύνῃσιν ἐνήσει ο198.",
    "headword_normalized": "ομοφροσυνη"
  },
  "ὁμόφρων": {
