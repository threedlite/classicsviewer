  "βούβρωστις": {
    "inflected_forms": [],
    "definition": "βούβρωστις, ἡ [app. a compound of βοῦς]. Explained as\n   the insect that attacks cattle, the gadfly. By\n   others connected with βιβρώσκω and explained as\n   ravenous hunger (taking βου- in an intensive sense.\n   Cf. βουγάϊος) Ω532.",
    "headword_normalized": "βουβρωστισ"
  },
  "βουβών": {
