  "λά̄ϊνος": {
    "inflected_forms": [
      "τεῖχος",
      "οὐδός",
      "χιτῶνα"
    ],
    "definition": "λά̄ϊνος [λᾶας]. Of stone: τεῖχος Μ178. Cf. ν106 (of\n   natural formations in a cave)--λάϊνος οὐδός Ι404:\n   θ80 (in both cases app. referring to the threshold\n   of a temple built of stone), π41 (in the hut of\n   Eumaeus), ρ30, υ258, ψ88 (in these three cases at\n   the entrance to the μέγαρον of Odysseus, app. a\n   massive and broad stone threshold on which the\n   μέλινος οὐδός rested (see μέλινος (2))).--Fig.:\n   λάϊνόν χ’ ἕσσο χιτῶνα Γ57 (would have been stoned).",
    "headword_normalized": "λαινοσ"
  },
  "λαισήϊον": {
    "inflected_forms": [],
    "definition": "λαισήϊον, ου, τό [app. conn. with λάσιος]. Thus, a\n   light shield of skin with the hair left on Ε453 =\n   Μ426.",
    "headword_normalized": "λαισηιον"
  },
  "λαῖτμα": {
    "inflected_forms": [
      "λαῖτμα"
    ],
    "definition": "λαῖτμα, τό [cf. λαιμός]. The gulf of the sea: τόδε\n   λαῖτμα διατμήξας ε409. Cf. η35, 276, ι323. --With\n   ἁλός: ἁλὸς ἐς μέγα λαῖτμα Τ267. Cf. θ561.--With\n   θαλάσσης: ὑπὲρ μέγα λαῖτμα θαλάσσης ι260. Cf. δ504,\n   ε174.",
    "headword_normalized": "λαιτμα"
  },
  "λαῖφος": {
