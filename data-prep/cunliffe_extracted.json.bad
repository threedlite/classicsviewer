  "ἀμύ̄νω": {
    "inflected_forms": [
      "ἀμῦναι",
      "ἄμῡνε",
      "ἤμῡνε",
      "ἄμῡνον",
      "λοιγόν",
      "ἄνδρα",
      "παιδός",
