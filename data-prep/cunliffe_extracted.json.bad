  "σεύω": {
    "inflected_forms": [
      "σεύατο",
      "σεύας",
      "σευάμενος",
      "ἐσσύμενος",
      "ἔσσευα",
      "σεῦα",
      "ἔσσευε",
      "σεῦε",
      "σεύῃ",
      "ἐσσεύοντο",
