  "λάσκω": {
    "inflected_forms": [
      "λάκε",
      "λεληκώς",
      "χαλκός"
    ],
    "definition": "†λάσκω. 3 sing. aor. λάκε Ν616, Ξ25, Υ277. Pf. pple.\n   λεληκώς Χ141. Fem. λελακυῖα μ85. (ἐπιληκέω.) To emit\n   a sharp or piercing sound. Of bones breaking with a\n   crack Ν616.--Of the  ring of struck metal: λάκε\n   χαλκός Ξ25. Cf. Υ277.--Of the cry of a bird of prey\n   in pursuit of its quarry: κίρκος ὀξὺ λεληκώς (with\n   shrill cry) Χ141.--Of the yell of Scylla μ85.",
    "headword_normalized": "λασκω"
  },
  "λαυκανίη": {
    "inflected_forms": [
      "καθέηκα"
    ],
    "definition": "λαυκανίη, ης, ἡ (cf. ἀσφάραγος, φάρυξ). The throat: ᾗ\n   κληῗδες ἀπ’ ὤμων αὐχέν’ ἔχουσι, λαυκανίην (in\n   'whole-and-part' apposition with αὐχένα) Χ325.--More\n   specifically, the gullet: οἶνον λαυκανίης καθέηκα\n   Ω642.",
    "headword_normalized": "λαυκανιη"
  },
  "λαύρη": {
    "inflected_forms": [],
    "definition": "λαύρη, ης, ἡ. A passage leading from front to back on\n   the outside of one of the side walls of the μέγαρον\n   χ128, 137.",
