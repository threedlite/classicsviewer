  "καταθνῄσκω": {
    "inflected_forms": [
      "κατατεθνηώς",
      "κάτθανε",
      "κατατεθνήκᾱσι",
      "Πάτροκλος",
      "κατατεθνήκασιν",
      "κατατεθνηῶτος"
    ],
    "definition": "καταθνῄσκω [κατα- (5)]. Contr. 3 aor. κάτθανε Ι320,\n   Φ107. 3 pl. pf. κατατεθνήκᾱσι Ο664. 3 sing. opt.\n   κατατεθναίη δ224. Pple. κατατεθνηώς, -ῶτος Η89, 409,\n   Κ343, 387, Π526, 565, Ρ369, Σ540, Χ164, Ψ331: κ530,\n   λ37, 147, 541, 564, 567, χ448. Genit. sing. fem.\n   κατατεθνηυίης λ84, 141, 205.\n1. To die: κάτθανε καὶ Πάτροκλος Φ107. Cf. Ι320, Χ355.\n2. In pf., to be dead: ἠμὲν ὅτεῳ ζώουσι καὶ ᾧ\n   κατατεθνήκασιν Ο664: εἴ οἱ κατατεθναίη μήτηρ (should\n   lie dead) δ224.--In pple., dead: ἀνδρὸς σῆμα\n   κατατεθνηῶτος Η89. Cf. Η409 (the dead bodies), Κ343,\n   387, Π526, 565, Ρ369 (the dead ...), Σ540, Χ164,\n   Ψ331: ψυχὴ μητρὸς κατατεθνηυίης λ84. Cf. κ530, λ37,\n   141, 147, 205, 541, 564, χ448.--Absol., the dead,\n   the departed: τῶν ἄλλων ψυχὰς κατατεθνηώτων λ567.",
    "headword_normalized": "καταθνησκω"
  },
  "καταθνητός": {
    "inflected_forms": [
      "τέτυκτο"
    ],
    "definition": "καταθνητός [κατα- (5) + θνητός]. Mortal, liable to\n   death: οὔ τι καταθνητὸς τέτυκτο Ε402 = 901. Cf.\n   Ζ123, Κ440: γ114, ι502, ρ587, τ285, υ76, ψ126.",
    "headword_normalized": "καταθνητοσ"
  },
  "καταθύ̄μιος": {
    "inflected_forms": [],
    "definition": "καταθύ̄μιος [κατα- (1) + θυμός]. Weighing on the heart,\n   troubling: οὔ τί τοι θάνατος καταθύμιός ἐστιν (thou\n   thinkest not of it) Ρ201. Cf. Κ383: ἔπος τό μοι\n   καταθύμιόν ἐστιν (that craves utterance) χ392.",
    "headword_normalized": "καταθυμιοσ"
  },
  "καταιβατός": {
