  "δημός": {
    "inflected_forms": [],
    "definition": "δημός, οῦ, ὁ. Fat Θ240, 380 = Ν832, Λ818, Φ127, 204,\n   Χ501, Ψ168, 243, 253, 750: ι464, ξ428, ρ241.",
    "headword_normalized": "δημοσ"
