  "σπάρτα": {
    "inflected_forms": [],
    "definition": "σπάρτα, τά [app. fr. σπάρτος, broom (i.e. the common,\n   hardly the Spanish, broom)]. Ropes or cables\n   (properly of broom) Β135.",
    "headword_normalized": "σπαρτα"
