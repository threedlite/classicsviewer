    "headword_normalized": "ευρυποροσ"
  },
  "εὐρυπυλής": {
    "inflected_forms": [],
    "definition": "εὐρυπυλής, ές [εὐρύς + πύλη]. Wide-gated. Epithet of\n   the house or realm of Hades: εὐρυπυλὲς Ἄϊδος δῶ Ψ74:\n   λ571.",
    "headword_normalized": "ευρυπυλησ"
  },
  "εὐρυρέεθρος": {
    "inflected_forms": [
      "Ἀξιός"
    ],
    "definition": "εὐρυρέεθρος [εὐρύς + ῥέεθρον]. Flowing with wide\n   streams, broad-channelled. Epithet of a river: Ἀξιός\n   Φ141.",
    "headword_normalized": "ευρυρεεθροσ"
