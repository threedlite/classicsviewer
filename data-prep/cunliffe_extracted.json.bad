  "ὑποφήτης": {
    "inflected_forms": [],
    "definition": "ὑποφήτης, ὁ [ὑπο- (12) + φημί]. One who gives an\n   interpretative response in regard to or reveals the\n   oracles of a god, a prophet Π235.",
    "headword_normalized": "υποφητησ"
