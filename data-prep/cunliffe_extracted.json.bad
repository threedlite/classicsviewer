  "μεταστρέφω": {
    "inflected_forms": [
      "μεταστρέψῃ",
      "μεταστρέψεις",
      "μεταστρέψειε",
      "οὔτασεν",
      "μεταστρεφθείς",
      "ἦτορ"
    ],
    "definition": "†μεταστρέφω [μετα- (6)]. 2 sing. fut. μεταστρέψεις\n   Ο203. 3 sing. aor. subj. μεταστρέψῃ Κ107. 3 pl.\n   μεταστρέψωσι β67. 3 sing. opt. μεταστρέψειε Ο52.\n   Aor. pple. pass. μεταστρεφθείς, -έντος Θ258, Λ447,\n   595, Ν545, Ο591, Ρ114, 732.\n1. In pass., to turn oneself about, wheel round, for\n   flight: Θόωνα μεταστρεφθέντα οὔτασεν Ν545. Cf. Θ258\n   = Λ447.--So as to face the foe: στῆ μεταστρεφθείς\n   Λ595 = Ο591 = Ρ114. Cf. Ρ732.\n2. To change (one's temper or mood): εἴ κε μεταστρέψῃ\n   ἦτορ Κ107. Cf. Ο52.--Absol., to change one's mind\n   Ο203.\n3. To work a change: μή τι μεταστρέψωσι [θεοί] (bring\n   some evil to pass) β67.",
    "headword_normalized": "μεταστρεφω"
  },
  "μετατίθημι": {
    "inflected_forms": [],
    "definition": "†μετατίθημι [μετα- (3)]. 3 sing. aor. μετέθηκε. To set\n   or cause among a company: οὔ κέ τι τόσον κέλαδον\n   μετέθηκεν (among us) σ402.",
    "headword_normalized": "μετατιθημι"
  },
  "μετατρέπομαι": {
