  "φυγή": {
    "inflected_forms": [],
    "definition": "φυγή, ῆς, ἡ [φυγ-, φεύγω].\n1. Flight: φυγῇ ἐπὶ νῆας ἱκέσθην (in flight) κ117.\n2. A means of flight or escape: οὐδέ τις γίγνεται φυγή\n   χ306.",
    "headword_normalized": "φυγη"
  },
  "φυγοπτόλεμος": {
