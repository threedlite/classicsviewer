  "πάμπαν": {
    "inflected_forms": [
      "χάζετο"
    ],
    "definition": "πάμπαν [παν-, πᾶς reduplicated with assimilation of the\n   ν]. Wholly, altogether, entirely, quite (in negative\n   statements and injunctions commonly rather\n   strengthening the negation than attaching itself\n   closely to the verb, etc., and to be translated 'at\n   all,' 'by any means,' 'in any wise,' or the like;\n   cf. πάγχυ): πολέμου ἀποπαύεο π. Α422, οὐδ’ ὅ γε π.\n   χάζετο Μ406. Cf. Ι435, Ν111, 761, Ξ91, Ρ406, Υ376,\n   etc.: βίοτον ἀπὸ π. ὀλέσσει β49, οὐδ’ Ἀγαμέμνονι π.\n   ἑήνδανεν γ143. Cf. δ693, θ552, λ528, π375, υ140,\n   etc.",
    "headword_normalized": "παμπαν"
  },
  "παμποίκιλος": {
    "inflected_forms": [],
    "definition": "παμποίκιλος [παμ-, παν-, πᾶς + ποικίλος]. All-\n   variegated, many-coloured Ζ289: ο105.",
    "headword_normalized": "παμποικιλοσ"
  },
  "πάμπρωτος": {
    "inflected_forms": [
      "μῆτιν",
      "φέροιο"
    ],
    "definition": "πάμπρωτος [παμ-, παν-, πᾶς + πρῶτος]. The first of all,\n   taking the lead: π. ὑφαίνειν ἤρχετο μῆτιν Η324 =\n   Ι93.--In neut. sing. πάμπρωτον as adv., first of\n   all, as the first thing, to start with: νῆας π.\n   ἐρύσσαμεν δ577. Cf. δ780, κ403, 423, λ2.--Sim. in\n   neut. pl. πάμπρωτα, first of all, before all others:\n   τοῦ κε π. παρὰ δῶρα φέροιο Δ97. Cf. Ρ568.",
    "headword_normalized": "παμπρωτοσ"
  },
  "παμφαίνω": {
    "inflected_forms": [
      "παμφαίνῃσιν"
    ],
    "definition": "παμφαίνω [reduplicated fr. φαίνω]. To shine, gleam,\n   glitter: ἀστέρα, ὅς τε μάλιστα λαμπρὸν παμφαίνῃσιν\n   Ε6, στήθεσι παμφαίνοντας (app., their (naked)\n   breasts glistening (instead of their armour)) Λ100.\n   Cf. Ζ513, Λ30, 63, Ξ11, Τ398, Χ26.",
    "headword_normalized": "παμφαινω"
  },
  "παμφανάω": {
    "inflected_forms": [
      "παμφανόωντα"
    ],
    "definition": "†παμφανάω [reduplicated fr. φαν-, φαίνω]. Pres. pple.\n   παμφανόων, -ωντος. Fem. παμφανόωσα. To shine, gleam,\n   glitter: τεύχεα παμφανόωντα Ε295. Cf. Β458, Ε619,\n   Ζ473, Σ206 Ψ613, etc.: δ42, ν29, τ386, χ121.",
    "headword_normalized": "παμφαναω"
