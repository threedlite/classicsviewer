  },
  "ἐπήρατος": {
    "inflected_forms": [
      "δαιτός",
      "πτολίεθρον"
    ],
    "definition": "ἐπήρατος, ον [ἐπ-, ἐπι- (19) + ἔραμαι. 'Lovely']. An\n   epithet of general commendation, pleasing, charming,\n   delightful, fair, or the like: δαιτός Ι228: εἵματα\n   θ366, ἄντρον ν103 = 347.--As epithet of places,\n   fair, pleasant: πτολίεθρον Σ512, Χ121. Cf. δ606.",
    "headword_normalized": "επηρατοσ"
  },
  "ἐπήρετμος": {
    "inflected_forms": [],
    "definition": "ἐπήρετμος, ον [ἐπ-, ἐπι- (2) + ἐρετμόν].\n1. At the oar: ἑταῖροι ἥατ’ ἐπήρετμοι β403.\n2. Epithet of ships, fitted or furnished with oars δ559\n   = ε16 = ρ145, ε141, ξ224.",
    "headword_normalized": "επηρετμοσ"
  },
  "ἐπηρεφής": {
