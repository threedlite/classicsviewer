  "πτερόν": {
    "inflected_forms": [
      "λίασθεν"
    ],
    "definition": "πτερόν, τό [π(έ)τομαι].\n1. A feather Λ454: β151, ε53, ο527.\n2. In pl., a bird's wings: σὺν πτερὰ πυκνὰ λίασθεν\n   Ψ879. Cf. Τ386, Ω319. --App. in sing. in the same\n   sense: ὠκεῖαι ὡς εἰ πτερὸν ἠὲ νόημα η36.--Fig. of\n   oars λ125 = ψ272.",
    "headword_normalized": "πτερον"
  },
  "πτέρυξ": {
