  "λωβεύω": {
    "inflected_forms": [],
    "definition": "λωβεύω [λώβη]. (ἐπι-.) To play a trick upon, mock, make\n   game of: τίπτε με λωβεύεις; ψ15. Cf. ψ26.",
    "headword_normalized": "λωβευω"
  },
  "λώβη": {
    "inflected_forms": [
      "λώβην"
    ],
    "definition": "λώβη, ης, ἡ.\n1. Treatment without regard to right or decency,\n   despiteful usage, outrage: πρίν γ’ ἀπὸ πᾶσαν ἐμοὶ\n   δόμεναι λώβην Ι387. Cf. Λ142, Ν622, Τ208: σ347 =\n   υ285, τ373, υ169, ω326.\n2. A cause or occasion of reproach or opprobrium: λώβη\n   τάδε γ’ ἔσσεται, εἰ ... Η97. Cf. Σ180: σ225, ω433.\n3. A mark for mockery, an object of ridicule Γ42.",
    "headword_normalized": "λωβη"
  },
  "λωβητήρ": {
    "inflected_forms": [],
    "definition": "λωβητήρ, ῆρος, ὁ [λωβάομαι]. One who utters despiteful\n   or scurrilous words, an insulter, a foul-mouthed\n   fellow Β275, Λ385.--A good-for-nothing person, a\n   worthless fellow Ω239.",
    "headword_normalized": "λωβητηρ"
  },
  "λωβητός": {
    "inflected_forms": [],
    "definition": "λωβητός [λωβάομαι]. App., despitefully used by fortune,\n   wretched, miserable Ω531.",
    "headword_normalized": "λωβητοσ"
  },
  "λωΐτερος": {
    "inflected_forms": [],
    "definition": "λωΐτερος [cf. next]. Better, more profitable or\n   advisable: τόδε λωΐτερον ἔμμεναι α376 = β141.",
    "headword_normalized": "λωιτεροσ"
  },
  "λωΐων": {
    "inflected_forms": [
      "ἀποαιρεῖσθαι",
      "ἔσσεσθαι"
    ],
    "definition": "λωΐων, λώϊον [cf. prec.]. Always in neut. Better.\n   Absol.: χρή σε δόμεναι καὶ λώϊον ἠέ περ ἄλλοι σίτου\n   (a larger portion) ρ417.--Better, more profitable or\n   advisable: τόδε σφιν λ. ἐστιν β169.--Absol. with\n   infin.: λ. ἐστι δῶρ’ ἀποαιρεῖσθαι Α229.--So with\n   ὧδε: δοκέει μοι ὧδε λ. ἔσσεσθαι Ζ339.--As adv.,\n   better, more fully: γνωσόμεθ’ ἀλλήλων καὶ λ. ψ109.",
    "headword_normalized": "λωιων"
  },
  "λώπη": {
    "inflected_forms": [],
    "definition": "λώπη, ης, ἡ [λέπω]. A garment ν224.",
    "headword_normalized": "λωπη"
  },
  "λωτόεις": {
    "inflected_forms": [
      "λωτοῦντα"
    ],
    "definition": "λωτόεις, εντος [λωτός (1)]. Contr. acc. pl. neut.\n   λωτοῦντα. Overgrown with λωτός: πεδία λωτοῦντα Μ283.\n   (V.l. λωτεῦντα (λωτέοντα) fr. λωτέω, to teem with\n   λωτός.)",
    "headword_normalized": "λωτοεισ"
