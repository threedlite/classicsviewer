<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classics Viewer</title>
    <link rel="stylesheet" href="/static/css/bootstrap.min.css">
    <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <span style="font-family: 'Times New Roman', serif; font-size: 56px; line-height: 0.6; font-weight: bold; color: #f8f9fa; margin-right: 20px; position: relative; top: -5px;">α</span>
                Classics Viewer
            </a>
            <div class="navbar-nav ms-auto">
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-light" id="greekBtn" 
                            onclick="setLanguage('greek')" 
                            <%= language === 'greek' ? 'disabled' : '' %>>
                        Greek
                    </button>
                    <button type="button" class="btn btn-outline-light" id="latinBtn" 
                            onclick="setLanguage('latin')"
                            <%= language === 'latin' ? 'disabled' : '' %>>
                        Latin
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-3">
        <div class="row">
            <!-- Left sidebar for navigation -->
            <div class="col-md-3">
                <!-- Search Card -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h5>Search</h5>
                    </div>
                    <div class="card-body">
                        <div class="input-group mb-2">
                            <input type="text" class="form-control" id="searchInput" placeholder="Search for words...">
                            <button class="btn btn-outline-secondary" type="button" onclick="performSearch()">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                </svg>
                            </button>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="lemmaSearch">
                            <label class="form-check-label" for="lemmaSearch">
                                Search all forms (lemma)
                            </label>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5>Authors</h5>
                    </div>
                    <div class="card-body" style="height: 300px; overflow-y: auto;">
                        <!-- Author filter controls -->
                        <div class="filter-controls mb-2">
                            <input type="text" class="form-control form-control-sm mb-2" id="authorSearchInput" placeholder="Filter authors...">
                            <div class="form-check form-check-sm">
                                <input class="form-check-input" type="checkbox" id="authorTranslationFilter">
                                <label class="form-check-label small" for="authorTranslationFilter">
                                    Only with translations
                                </label>
                            </div>
                            <div class="filter-count small text-muted mt-1" id="authorFilterCount" style="display: none;"></div>
                        </div>
                        <div id="authorList" class="list-group">
                            <!-- Authors will be loaded here -->
                        </div>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h5>Works</h5>
                    </div>
                    <div class="card-body" style="height: 300px; overflow-y: auto;">
                        <!-- Work filter controls -->
                        <div class="filter-controls mb-2">
                            <input type="text" class="form-control form-control-sm mb-2" id="workSearchInput" placeholder="Filter works...">
                            <div class="form-check form-check-sm">
                                <input class="form-check-input" type="checkbox" id="workTranslationFilter">
                                <label class="form-check-label small" for="workTranslationFilter">
                                    Only with translations
                                </label>
                            </div>
                            <div class="filter-count small text-muted mt-1" id="workFilterCount" style="display: none;"></div>
                        </div>
                        <div id="bookList" class="list-group">
                            <!-- Works will be loaded here -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main content area -->
            <div class="col-md-9">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 id="contentTitle">Select an author and work</h5>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary" id="textBtn" onclick="showText()">Text</button>
                                <button type="button" class="btn btn-outline-primary" id="translationBtn" onclick="showTranslation()">Translation</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body" style="height: 600px; overflow-y: auto;">
                        <div id="contentArea">
                            <p class="text-muted text-center mt-5">Select an author and work from the left sidebar to begin reading.</p>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex justify-content-between align-items-center">
                            <button class="btn btn-sm btn-secondary" onclick="loadPreviousPage()" id="prevBtn" disabled>
                                Previous
                            </button>
                            <span id="pageInfo">Page: 0</span>
                            <button class="btn btn-sm btn-secondary" onclick="loadNextPage()" id="nextBtn" disabled>
                                Next
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- License link -->
    <div style="position: fixed; bottom: 10px; right: 10px; font-size: 0.85rem;">
        <a href="/license" target="_blank" class="text-muted">License</a>
    </div>

    <!-- Word Info Panel -->
    <div id="wordInfoPanel">
        <div class="panel-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 id="selectedWord" class="mb-0 d-inline">Word</h5>
                    <span id="selectedWordMorph" class="ms-2 text-muted small"></span>
                </div>
                <button type="button" class="btn-close" onclick="closeWordPanel()"></button>
            </div>
        </div>
        <div class="panel-content">
            <!-- Tabs for Dictionary and Occurrences -->
            <ul class="nav nav-tabs word-info-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="dictionary-tab" data-bs-toggle="tab" data-bs-target="#dictionary-content" type="button" role="tab">
                        Dictionary
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="morphology-tab" data-bs-toggle="tab" data-bs-target="#morphology-content" type="button" role="tab" onclick="loadMorphologyIfNeeded()">
                        Morphology
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="occurrences-tab" data-bs-toggle="tab" data-bs-target="#occurrences-content" type="button" role="tab" onclick="loadOccurrencesIfNeeded()">
                        Occurrences
                    </button>
                </li>
            </ul>
            
            <div class="tab-content">
                <div class="tab-pane fade show active" id="dictionary-content" role="tabpanel">
                    <div id="dictionaryResults">
                        <div class="loading">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="morphology-content" role="tabpanel">
                    <div id="morphologyResults">
                        <p class="text-muted">Click the Morphology tab to load analysis.</p>
                    </div>
                </div>
                <div class="tab-pane fade" id="occurrences-content" role="tabpanel">
                    <div id="occurrencesResults">
                        <div class="loading">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/static/js/bootstrap.bundle.min.js"></script>
    <script src="/static/js/app.js"></script>
</body>
</html>