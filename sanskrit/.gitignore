# Python virtual environment
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Database files (too large for git)
*.db
*.db.zip

# Downloaded data
data-sources/*.html
data-sources/*.json
data-sources/*_api.json

# Generated data files (too large)
dcs_sanskrit_dictionary.csv
dcs_sanskrit_morphology.csv
dcs_extraction_stats.json
dcs_missing_words.txt

# Generated interlinear output
interlinear/

# Test files
test_*.txt
test_*.xml
bhagavad_gita_wikisource/
bhagavad_gita/

# Build logs
build.log
interlinear.log
extended_build*.log

# Ganguli Mahabharata translation, fetched by data-sources/download_ganguli.sh (the build runs it when missing)
data-sources/ganguli/*.txt

# Mueller Chandogya translation, fetched by data-sources/download_chandogya_mueller.sh (the build runs it when missing)
data-sources/mueller/

# Griffith Rig Veda translation, fetched by data-sources/download_rigveda_griffith.py (the build runs it when missing)
data-sources/wikisource/

# Registry translations (data-sources/translation_sources.py): fetched pages and parsed files, rebuilt on demand
data-sources/generated/

# Interlinear generation output (one directory per build name)
interlinear_output*/
